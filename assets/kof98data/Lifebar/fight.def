team2.text.font = 6,0,-1
team1.text.scale= 1,1
team2.text.scale= 1,1

team1.displaytime = 100
team2.displaytime = 100
;-----------------------------------------------------------
[Round]
match.wins = 2              ;Rounds needed to win a match
match.maxdrawgames = 1      ;Max number of drawgames allowed (-1 for infinite)
start.waittime = 30         ;Time to wait before starting intro

; Default position for all components
pos = 0,0

; ROUND X
round.time = 0              ;Time to show round display
round.default.offset = 0,0
; Default component to show for each round. Text can include a %i to
; the round number. Use "round.default.anim" for animation instead of
; text.
;round.default.font = 8,0, 0
;round.default.text = "ABCDEFGHIJKLMNO"
round.default.displaytime = 60
;round.default.scale = 1,1
; Sounds to play for each round (optional, specify up to round 9)
round1.snd = 1,1
round2.snd = 1,2
round3.snd = 1,3
round4.snd = 1,4
round5.snd = 1,5
round6.snd = 1,6
round7.snd = 1,7
round8.snd = 1,8
round9.snd = 1,9
round.sndtime = 0           ;Time to play the sounds
; Components to show for each round (optional, specify up to round 9)
; Uncomment to use
round1.offset = 0,0
round2.offset = 0,0
round3.offset = 0,0
round4.offset = 0,0
round5.offset = 0,0
round6.offset = 0,0
round7.offset = 0,0
round8.offset = 0,0
round9.offset = 0,0
round1.anim = 80
round2.anim = 81
round3.anim = 82
round4.anim = 83
round5.anim = 84
round6.anim = 85
round7.anim = 86
round8.anim = 87
round9.anim = 88

; FIGHT
fight.time = 0             ;Time to show FIGHT component
fight.offset = 0,0    ;Component for FIGHT display
fight.anim = 89           ;.
fight.snd = 2,0             ;Sound to play
fight.sndtime = 20           ;Time to play sound

ctrl.time = 130             ;Time players get control after "Fight"

; KO
KO.time    = 0              ;Time to show KO component
KO.offset  = 0,0      ;Component for KO display
KO.anim    = 90            ;.
KO.snd     = 2,1           ;Sound to play for KO announcement
; Double KO
DKO.offset = 0,0
DKO.anim  = 91
DKO.displaytime = 78
DKO.snd    = 2,4
; Time Over
TO.offset  = 0,0
TO.anim    = 92
TO.snd     = 2,2
KO.sndtime = 0             ;Time to play sound for KO, DKO and TO.
slow.time  = 60            ;Time for KO slowdown (in ticks)
over.waittime = 45         ;Time to wait after KO before player control is stopped
over.hittime = 10          ;Time after KO that players can still damage each other (for double KO)
over.wintime = 45          ;Time to wait before players change to win states
over.time = 210            ;Time to wait before round ends
; Time to wait before showing win/draw message
win.time = 130
win.snd = 0,18
; Win text
win.offset = 0,0
win.anim = 94
; 2-player win text
win2.offset = 0,0
win2.anim = 94
; Draw text
draw.time = 200
draw.offset = 0,0
draw.anim = 93
draw.snd = 2,3

