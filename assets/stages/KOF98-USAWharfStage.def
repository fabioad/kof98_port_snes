;------------------------------------------------------------------------------
;------------The King Of Fighters'98--USA WharfStage(USA Wharfステージ）-------
;製作：RYO 2005-----1月21日製作終了--------------------------------------------

[Info]        
name           = "KOF98 USA Wharf Stage" 

;------------------------------------------------------------------------------
[Camera]
startx         = 0         
starty         = 0           
                             
boundleft      = -216        
boundright     = 216        
boundhigh      = -10          
boundlow       = 0          
verticalfollow = 0           
tension        = 50          

;------------------------------------------------------------------------------
[PlayerInfo]
;--- プレイヤー１ ---           
p1startx       = -70        
p1starty       = 0           
p1startz       = 0           
p1facing       = 1  
         
;--- プレイヤー２ ---             
p2startx       = 70         
p2starty       = 0           
p2startz       = 0           
p2facing       = -1  
        
;--- Common ---              
leftbound      = -1000       
rightbound     = 1000        
topbound       = 0           
botbound       = 0           

;------------------------------------------------------------------------------
[Scaling]
topz           = 0           
botz           = 50         
topscale       = 1           
botscale       = 1.2        

;------------------------------------------------------------------------------
[Bound]
screenleft     = 20          
screenright    = 20          

;------------------------------------------------------------------------------
[StageInfo]
zoffset        = 218         
autoturn       = 1           
;resetBG       = 1           

;------------------------------------------------------------------------------
[Shadow]

color = 256,256,256
                            
yscale         = 0.2         
          
;------------------------------------------------------------------------------
;--- 背景音楽指定         
[Music]
bgmusic = sound/Tears.mp3
bgvolume       = 255

;------------------------------------------------------------------------------
;---sffファイル指定
[BGdef]
spr            = stages/KOF98-USAWharfStage.sff
debugbg        = 1              

