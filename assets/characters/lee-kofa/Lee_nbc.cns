;------------

[Statedef 100]
type = S
physics = S
anim = 100
ctrl = 1

[State 100, 1]
type = VelSet
trigger1 = time > 4
x = const(velocity.run.fwd.x)

[State 191, Spray Anim P1]
type = Explod
trigger1 = time >= 5 && timemod = 10,0
trigger1 = StageVar(info.author) = "water"
ID = 20
anim = F21
postype = p1
pos = -10,0
ownpal = 1
ontop = 1
bindtime = 1
removetime = -2

; Play sound when running
[State 100, 2]
type = PlaySnd
trigger1 = time = 5
value = F100,0+(StageVar(info.author) = "water")
channel = 20
volume = 0
loop = 1

;Stop channel 20's sound when button fwd is release
[State 100, 3]
type = StopSnd
triggerall = var(59) = 0
trigger1 = AnimElem = 5, >= 0
trigger1 = Command != "holdfwd"
channel = 20;running snd

[State 100, 4]
type = ChangeState
triggerall = time > 12
trigger1 = var(59) = 0
trigger1 = Command != "holdfwd"
value = 101
ctrl = 1

;AI MODIFICATION
[State 100, 5]
type = ChangeState
triggerall = var(59) != 0
triggerall = time > 12
triggerall = p2movetype != H
trigger1 = P2BodyDist x <= 10
trigger2 = P2MoveType = A
value = 101
ctrl = 1

[State 100, 6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

;------------------------------------
; Run end to Stand
[Statedef 101]
type = S
physics = S
velset = 0,0
ctrl = 1

;Stop channel 20's sound when button fwd is release
[State 100, 3]
type = StopSnd
trigger1 = time = 0
channel = 20;running snd

[State 101, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = anim != 101
value    = 101

[State 101, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

