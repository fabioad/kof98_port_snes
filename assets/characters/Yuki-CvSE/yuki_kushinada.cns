; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
velset = 0,0

[State 52, 1]
type = playsnd
trigger1 = !time
value = s47,0

[State 52, 2]
type = PosSet
trigger1 = !time
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2]
type = Playsnd
trigger1 = time = 0
value = s100,1
channel = 2
loop = 1

[State 100, 3]
Type = ChangeState
Trigger1 = Command = "holdup"
Value = 40

[State 100, 4]
type = ChangeState
triggerall = Time > 9
trigger1 = command != "holdfwd"
value = 101
ctrl = 0

; RUN_FWD END
[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1
ctrl = 0
velset = 0,0

[State 101, 1]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = S
physics = S
ctrl = 0
anim = 105
sprpriority = 1
velset = 0,0

[State 105, 1]
type = Playsnd
trigger1 = animelem = 2
value = s105,0

;exp = e**
; x = a*e^(-b*x)
; a = 8.7461
; b = 0.0645

[State 105, 2]
type = VelSet
trigger1 = animElemTime(2) >= 0
x = -(8.66797232095506*exp((-0.05211626303051)*(time)))

[State 105, 3]
type = VelSet
trigger1 = animElemTime(2) = 0
y = const(velocity.run.back.y)

[State 105, 4]
type = Veladd
trigger1 = animElemTime(2) >= 0
y = .4375

[State 105, 5]
type = Veladd
trigger1 = time >= 11
y = -.2265625

[State 105, 6]
type = StateTypeSet
trigger1 = animElemTime(2) = 0
statetype = A
physics = N

[State 105, 7]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

