type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((4-var(21))*fvar(12))
ignorehitpause = 1
persistent = 0

[State 1001, スタン値削り]
type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
triggerall = fvar(15) = 0
trigger1 = movehit = 1
fvar(13) = floor((16-var(21))*fvar(16))
ignorehitpause = 1
persistent = 0

