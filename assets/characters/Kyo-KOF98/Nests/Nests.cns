trigger1 = wintime
trigger1 = time = 100
value = s15,2
persistent = 0
AbsPan = 0

[State 181, エフェクト表示]
type = Explod
trigger1 = wintime
trigger1 = time = 189
trigger1 = teamside = 1
anim = 8110
ID = 180
ownpal = 1
pos = 8,45
postype = left
bindtime = -1
ontop = 1
persistent = 0

[State 181, エフェクト表示]
type = Explod
trigger1 = wintime
trigger1 = time = 189
trigger1 = teamside = 2
anim = 8111
ID = 180
ownpal = 1
pos = 8,45
postype = left
bindtime = -1
ontop = 1
persistent = 0

[State 181, 音を鳴らす]
type = PlaySnd
trigger1 = wintime
trigger1 = time = 205
value = s15,1
persistent = 0
AbsPan = 0

;--------------------------------
[State 182, 特殊効果]
type = AssertSpecial
trigger1 = wintime = 0
trigger1 = Time = [0,220]
trigger2 = wintime
trigger2 = Time = [0,380]
flag = roundnotover

[State 182, エフェクト表示]
type = explod
triggerall = teammode = single || teammode = turns
trigger1 = wintime = 0
trigger1 = Time = 200
trigger2 = wintime
trigger2 = Time = 360
anim = 8000
ID = 78000
ontop = 1
postype = left
scale = 500.0,10.0
ownpal = 1
bindtime = -1
ignorehitpause = 1

[State 182, 特殊効果]
type = AssertSpecial
trigger1 = numexplod(78000) = 1
flag = nobardisplay

[State 182, ChangeState]
type = ChangeState
triggerall = matchover
trigger1 = wintime = 0 && Time = 216
trigger2 = wintime && Time = 376
value = 189

