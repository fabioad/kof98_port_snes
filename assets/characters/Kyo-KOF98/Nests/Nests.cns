;---------------------------------------------------------------------------
; イントロ分岐
; CNS レベル: 基本
;
; ここでは変数(var)を使っていますが、詳しい説明は後ほど。
; VarRandomはrangeで指定された範囲からひとつを選ぶので、
; いろいろな分岐に便利です。

;イントロ選択
[Statedef 190]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 190, 対庵]
type = ChangeState
trigger1 = p2name = "Iori Yagami" || p4name = "Iori Yagami"
trigger1 = EnemyNear,AuthorName = "ikaruga"
value = 192

[State 190, 対K']
type = ChangeState
trigger1 = p2name = "K'" || p4name = "K'"
trigger1 = EnemyNear,AuthorName = "ikaruga"
value = 193

[State 190, 対リュウ]
type = ChangeState
trigger1 = Enemy,Name = "Ryu"
trigger1 = Enemy,AuthorName = "ikaruga" || Enemy,AuthorName = "Soy Sauce"
value = 990

[State 190, ステート変更]
type = ChangeState
trigger1 = 1
value = 191

;---------------------------------------------------------------------------
; vs庵用イントロ分岐

[Statedef 192]
type = S
ctrl = 0
anim = 9999
velset = 0,0

[State 192, VarSet]
type = VarSet
trigger1 = 1
var(41) = 0

[State 192, 特殊効果] ;「ROUND1, FIGHT!」のアナウンスが始まるまでは、このコントローラを使ってください
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態になります

[State 192, 特殊効果]
type = AssertSpecial
trigger1 = numexplod(78000) = 1
flag = nobardisplay

[State 192, ステート変更 - '98]
type = ChangeState
triggerall = Time = 1
trigger1 = Enemy,AuthorName = "ikaruga"
trigger1 = Enemy,var(24) = 0
value = 900

[State 192, ステート変更 - '98]
type = ChangeState
triggerall = Time = 1
trigger1 = Enemy,AuthorName = "ikaruga"
trigger1 = Enemy,var(24) = 1
value = 935

[State 192, ステート変更]
type = ChangeState
triggerall = Time = 2
trigger1 = 1
value = 945

;---------------------------------------------------------------------------
; 対K'
[Statedef 193]
type = S
ctrl = 0
anim = 192
velset = 0,0

[State 193, 特殊効果] ;「ROUND1, FIGHT!」のアナウンスが始まるまでは、このコントローラを使ってください
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態になります

[State 193, 特殊効果]
type = AssertSpecial
trigger1 = numexplod(78000) = 1
flag = nobardisplay

[State 193, ChangeAnim]
type = ChangeAnim
;trigger1 = RoundNo = 1
trigger1 = Time <= 48
value = 192
Elem = 1

[State 193, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5
value = s12,2

[State 193, エフェクト表示]
type = Explod
trigger1 = AnimElem = 5
anim = 193
postype = P1
pos = 4, 3
sprpriority = 5
ownpal = 1

[State 193, ステート変更]
type = ChangeState
trigger1 = AnimElemTime(8) >= 72
trigger1 = numhelper(7600) = 0
value = 0

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, エフェクト表示]
type = Explod
trigger1 = RoundNo != 1
trigger1 = time = 0
trigger1 = numexplod(78000) = 0
anim = 8001
ID = 78000
ontop = 1
postype = left
scale = 500.0,10.0
ownpal = 1
bindtime = -1
ignorehitpause = 1

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

;------------------------
;キャラ判定
;------------------------
[State 5900, VarSet]
type = VarSet
trigger1 = 1
var(24) = 1

;------------------------
;トレモ判定
;------------------------
[State 5900, LifeSet]
type = LifeSet
trigger1 = roundsexisted = 0
trigger1 = time = 0
value = 0

[State 5900, VarSet]
type = VarSet
triggerall =!var(39) = 1
trigger1 = roundsexisted = 0
trigger1 = time = 0
trigger1 = Life = 1
trigger2 = p2name = "Training"
trigger2 = enemy,authorname = "stupa"
trigger3 = p2name = "TRM Man"
trigger3 = enemy,authorname = "M3"
var(39) = 1

[State 5900, LifeSet]
type = LifeSet
trigger1 = roundsexisted = 0
trigger1 = time = 0
value = LifeMax
;------------------------

[State 5900, 二人目のイントロ];特殊イントロ持ち
type = ChangeState             ;二人目でもイントロを作る
value = 190                    ;イントロへ
triggerall = TeamMode = Turns  ;ターンモード
triggerall = roundno > 1       ;2ラウンド目以降
trigger1 = var(5) = 1
trigger2 = Enemy,Name = "Ryu"
trigger2 = Enemy,AuthorName = "ikaruga" || Enemy,AuthorName = "Soy Sauce"

[State 5900, 二人目のイントロ]
type = ChangeState             ;二人目でもイントロを作る
value = 5903;5901              ;イントロへ
triggerall = TeamMode = Turns  ;ターンモード
triggerall = roundno > 1       ;2ラウンド目以降
trigger1 = RoundsExisted = 0   ;自分が初参戦時

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
trigger2 = RoundsExisted = 0
trigger2 = TeamMode = Turns
trigger2 = RoundNo > 0
value = 190

;この下、一行以上空ける事！
