;---------------------------------------------------------------------------
; EXキャラのステート
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 0, 3] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 0, 4]
type = DestroySelf
trigger1 = IsHelper

[State 0, 5]
type = AfterImage
trigger1 = time = 0
time = 1

[State 0, 6]
type = Turn
trigger1 = var(59) = 1 && ctrl = 0
trigger1 = teammode = single || teammode = turns
trigger1 = p2dist x < 0

;---------------------------------------------------------------------------
; 勝利ポーズ分岐
; CNS レベル: 基本
;
;ここで勝利ポーズを選択する。　MatchOverは試合終了を判定するので、
;一回目と二回目勝利を別のポーズにしたい時に便利。

[Statedef 180]
type = S
ctrl = 0
;anim = ifelse(Anim = 1,1,0)
velset = 0,0

[State 180, VarSet]
type = VarSet
trigger1 = command = "holdx"
trigger2 = command != "holdx" && command != "holda" && command != "holdy" && command != "holdb"
trigger2 = Random%4 = 0
var(0) = 0

[State 180, VarSet]
type = VarSet
trigger1 = command = "holda"
trigger2 = command != "holdx" && command != "holda" && command != "holdy" && command != "holdb"
trigger2 = Random%4 = 1
var(0) = 1

[State 180, VarSet]
type = VarSet
trigger1 = command = "holdy"
trigger2 = command != "holdx" && command != "holda" && command != "holdy" && command != "holdb"
trigger2 = Random%4 = 2
var(0) = 2

;[State 180, VarSet]
;type = VarSet
;trigger1 = command = "holdb"
;trigger2 = command != "holdx" && command != "holda" && command != "holdy" && command != "holdb"
;trigger2 = Random%4 = 3
;var(0) = 3

[State 180, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = roundnotover

[State 180, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != [0,1]
value = ifelse(Anim = 1,1,0)

[State 180, Explod]
type = Explod
trigger1 = wintime = 0
trigger1 = numhelper(8100) = 0
trigger1 = teamside = 1
anim = 8110
ownpal = 1
pos = 8,45
postype = left
bindtime = -1
ontop = 1
persistent = 0

[State 180, Explod]
type = Explod
trigger1 = wintime = 0
trigger1 = numhelper(8100) = 0
trigger1 = teamside = 2
anim = 8111
ownpal = 1
pos = 8,45
postype = left
bindtime = -1
ontop = 1
persistent = 0

[State 180, VarSet]
type = VarSet
trigger1 = time = 0
var(16) = 0

[State 180, VarAdd]
type = VarAdd
trigger1 = wintime = 0
trigger1 = numhelper(8100) = 0
var(16) = 1

[State 180, PlaySnd]
type = PlaySnd
trigger1 = wintime = 0
trigger1 = var(16) > 16
trigger1 = numhelper(8100) = 0
value = s15,1
volume = 255
persistent = 0
AbsPan = 0

[State 180, ステート変更]
type = ChangeState
trigger1 = wintime = 0
trigger1 = var(16) >= 32
trigger2 = wintime
trigger2 = time = 0
trigger3 = time = 200
value = 181 + var(0)

;---------------------------------------------------------------------------
; 勝利ポーズ2(燃えねえなあ)
