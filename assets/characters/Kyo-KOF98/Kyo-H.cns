triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((16-Root,var(21))*Root,fvar(12))
ignorehitpause = 1
persistent = 0
[State 3000, ガード弾き値回復不能時間]
type = ParentVarSet
triggerall = Root,fvar(11) != 300
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(11) = 300

[State 3000, 気絶値回復不能時間]
