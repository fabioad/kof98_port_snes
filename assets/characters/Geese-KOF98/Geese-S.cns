;---------------------------------------------------------------------------
;(HELPER)飛び道具相殺判定
[Statedef 1020]
type     = S
movetype = I
physics  = N
ctrl     = 0
anim     = 9999
sprpriority = 5

[State 1020, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 1020, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 1020, 飛び道具(相殺用)]
type = Projectile
Triggerall = IsHelper(1000)
Trigger1 =!Time
Trigger1 = Root,NumProjID(1000) = 0
Trigger2 = Root,NumProjID(1000) = 1
projID = 1000
projanim = 1003 + ((Root,AnimElemTime(6) >= 0 && Root,AnimElemTime(7) < 0) * 1) + ((Root,AnimElemTime(7) >= 0) * 2)
projhitanim = -1
projscale = 1, 1
projremove = 1
projremovetime = 1
velocity = Vel X, Vel Y
projpriority = 1
offset = 0, 0
ignorehitpause = 1

[State 1020, 飛び道具(相殺用)]
type = Projectile
Triggerall = IsHelper(1010)
Trigger1 =!Time
Trigger1 = Root,NumProjID(1000) = 0
Trigger2 = Root,NumProjID(1000) = 1
projID = 1000
projanim = 1003 + ((Root,AnimElemTime(15) >= 0 && Root,AnimElemTime(16) < 0) * 1) + ((Root,AnimElemTime(16) >= 0) * 10)
projhitanim = -1
projscale = 1, 1
projremove = 1
projremovetime = 1
velocity = Vel X, Vel Y
projpriority = 1
offset = 0, 0
ignorehitpause = 1

[State 301, このヘルパーを消す]
type = DestroySelf
Triggerall = Time
Trigger1 = Root,NumProjID(1000) = 0
Trigger2 = Root,StateNo != 1000 && Root,StateNo != 1010
Trigger3 = Root,Anim = 1001 && Root,AnimElem = 8
Trigger4 = Root,Anim = 1011 && Root,AnimElem = 8
Trigger5 = Root,Anim = 1011 && Root,AnimElem = 18

