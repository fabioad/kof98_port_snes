movetype= H
physics = N
sprpriority = -2

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
triggerall = Time = 0
trigger1 = Anim = 5081
trigger2 = Anim = 5101
trigger3 = Anim = 5161
trigger4 = Anim = 5171
trigger5 = Anim = 5111
trigger6 = Anim = 5950
value = 5111

[State 5150, pos]
type = PosSet
trigger1 = 1
y= 0

[State 5150, pos]
type = velSet
trigger1 = 1
y = 0
x = 0

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
trigger1 = roundstate = 4
triggerall = time >= 20
trigger1 = MatchOver = 0
trigger1 = teammode = single || teammode = simul
trigger1 = (anim = [5110,5119]) || (anim = [5170,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10) + (drawgame||win)*2

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
trigger1 = roundstate = 4
triggerall = time >= 20
trigger1 = MatchOver && !lose
trigger1 = teammode = single || teammode = simul
trigger1 = (anim = [5110,5119]) || (anim = [5170,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10) + (drawgame||win)*2

[State 5150, 4] ;Match over anim
type = ChangeAnim
trigger1 = roundstate = 4
triggerall = time >= 20
trigger1 = MatchOver || teammode = turns
trigger1 = (anim = [5110,5119]) || (anim = [5170,5179])
trigger1 = SelfAnimExist(5150 + (anim % 10))
value = 5150 + (anim % 10)

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5111]
