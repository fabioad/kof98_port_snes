power = 5000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 25
airjuggle = 20
sparkno = -1
guard.sparkno = -1
KO.echo = 0
volume = 255
IntPersistIndex = 50
FloatPersistIndex = 40

[Size]
