;---------------------------------------------------------------------------
; ここからは必殺技のステート
;---------------------------------------------------------------------------
; 弱ブリッツボール・上段

[Statedef 1000]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = floor(3*fvar(8))
velset   = 0,0
anim     = 1000 + (var(10) = 1)
ctrl     = 0
sprpriority = 3
facep2 = 1

[State 1000, VarSet]
type = VarSet
trigger1 = time = 0
var(15) = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s10,20
channel = 0

[State 1000, エフェクト表示]
type = Explod
trigger1 = Anim = 1001 && AnimElem = 1,= 1
anim = 1002
postype = P1
pos = 0,0
sprpriority = 5
bindtime = -1
removeongethit = 1
ownpal = 1

[State 1000, ヘルパーを出す]
type = Helper
trigger1 = Anim = 1000 && AnimElem = 5,= 1
trigger2 = Anim = 1001 && AnimElem = 4,= 1
stateno = 1020
id = 1000
name = "Proj"
pos = 70, -91
postype = P1
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 1000, MoveType]
type = StateTypeSet
trigger1 = Anim = 1000 && AnimElem = 6
trigger2 = Anim = 1001 && AnimElem = 5
MoveType = I

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

