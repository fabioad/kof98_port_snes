;---------------------------------------------------------------------------
; ここからは必殺技のステート
;---------------------------------------------------------------------------
; 弱G・キッケン

[Statedef 1000]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = floor(3*fvar(8))
velset   = 0,0
anim     = 1000
ctrl     = 0
sprpriority = 3
facep2 = 1

[State 1000, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(16) = 2
value = 1001

[State 1000, VarSet]
type = VarSet
trigger1 = time = 0
var(15) = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s10,20
channel = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
value = s12,3

[State 1000, エフェクト表示]
type = Explod
trigger1 = AnimElem = 4
anim = 1003
sprpriority = 5
postype = p1
pos = 32, 0
;bindtime = -1
supermove = 0
under = 0
ownpal = 1

[State 1000, StateTypeSet]
type = StateTypeSet
trigger1 = Anim = 1001
trigger1 = AnimElem = 5,= 1
statetype = A
physics = N

[State 1000, VelSet]
type = VelSet
trigger1 = Anim = 1001
trigger1 = AnimElem = 5,= 1
x = 6
y = -5

[State 1000, VelMul]
type = VelMul
trigger1 = Anim = 1001
trigger1 = AnimElemTime(5) >= 1
x = .96

[State 1000, VelAdd]
type = VelAdd
trigger1 = Anim = 1001
trigger1 = AnimElemTime(5) >= 1
y = .6

[State 1000, ヘルパーを出す]
type = Helper
trigger1 = Anim = 1000
trigger1 = AnimElem = 4,= 1
trigger2 = Anim = 1001
trigger2 = AnimElem = 4
stateno = 1005
id = ifelse(Anim = 1001,1001,1000)
name = "Proj"
pos = 48, 0
postype = P1
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 1000, ヒット定義]
type = HitDef
triggerall = var(12) = 0
triggerall =!movecontact && !movereversed
trigger1 = Anim = 1001
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
trigger1 = var(28) := 1
attr = S, SA
damage    = floor(7*fvar(7)),floor(1*fvar(7))
getpower  = floor(4*fvar(8)),floor(4*fvar(8))
givepower = floor(1*fvar(8)),floor(1*fvar(8))
animtype  = Hard
air.animtype = back
guardflag = M
hitflag   = MAF
priority  = 4, Hit
pausetime = 11+(Helper(40000),var(0)),13
guard.pausetime = 11+(Helper(40000),var(0)),11
sparkno = s6002+ifelse(var(40),3,0)
guard.sparkno = s6012
sparkxy = -20, -88
hitsound = s1,1
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
guard.velocity = -10.5-ifelse(var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
airguard.velocity = -4-ifelse(var(40),0.5,0),-1-ifelse(var(40),0.5,0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall.yvelocity = -3.5
yaccel = .5
fall = 1
fall.recover = 1
fall.recovertime = 600
ID = 50

[State 1000, ガード弾き値削り]
type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((8-var(21))*fvar(12))
ignorehitpause = 1
persistent = 0

[State 1000, 気絶値削り]
type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
triggerall = fvar(15) = 0
trigger1 = movehit = 1
fvar(13) = floor((8-var(21))*fvar(16))
ignorehitpause = 1
persistent = 0

[State 1000, MoveType]
type = StateTypeSet
trigger1 = AnimElem = 5
MoveType = I

[State 1000, ステート変更]
type = ChangeState
trigger1 = Anim = 1000
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 1000, ステート変更]
type = ChangeState
trigger1 = Anim = 1001
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 1001

