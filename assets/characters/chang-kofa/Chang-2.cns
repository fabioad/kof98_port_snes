[State -2, Corner Push]
type = Varset
triggerall = fvar(17) = 0
triggerall = (enemy(0), BackEdgeBodyDist <= 0) || (enemy(0), FrontEdgeBodyDist <= 0)
triggerall = enemy(0), GetHitVar(yvel) = 0
triggerall = ProjContact = 0, < 50
