trigger1 = Parent,Stateno != 1000 && Parent,Stateno != 1010
trigger2 = Time >= 90 && Parent,Stateno != 1010
trigger3 = Parent,Animelemtime(12)=3 && Parent,Stateno != 1010
trigger4 = Time > 179 && Parent,Stateno = 1010
trigger5 = Parent,Animelemtime(20)=5 && Parent,Stateno = 1010
ignorehitpause =1

[State 0, NotHitBy]
