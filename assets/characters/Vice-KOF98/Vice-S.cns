;-------------------------------------------------------------------------------
; アウトレイジ・弱  (Outrage / Light)
[Statedef 1000]
type = S
movetype = A
physics = S
velset = 0, 0
ctrl = 0
anim = 1000
poweradd = 60
juggle = 7

[State 1000,VarSet]
type = VarSet
trigger1 = Time = 0
v = 1
value = 0

[State 1000,VarSet]
type = VarSet
trigger1 = Time = 0
v = 7
value = 0

[State 1000,VarAdd]
