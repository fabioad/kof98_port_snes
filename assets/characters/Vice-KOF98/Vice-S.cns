trigger1 = AnimElem = 4 || AnimElem = 6 || AnimElem = 9 || AnimElem = 11
trigger2 = AnimElem = 14 || AnimElem = 16 || AnimElem = 19 || AnimElem = 21
v = 7
value = 1
ignorehitpause = 1

[State 1000,VarAdd]
