trigger1 = 1
value = SCA

[State 181,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 181, 0

[State 181,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 7, = 70
value = 181, 1

[State 181,3]
type = AssertSpecial
trigger1 = Time = [0,200]
flag = RoundNotOver

