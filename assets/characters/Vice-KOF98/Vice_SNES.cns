;---------------------------------------------------------------------------
; プレイントロ
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190,VarSet]
type = VarSet
trigger1 = Time = 0
trigger1 = P2Name = "Saisyu Kusanagi" || P4Name = "Saisyu Kusanagi" || P2Name = "Saisyu" || P4Name = "Saisyu"
v = 8
value = 1

[State 190, 2]
type = ChangeState
trigger1 = Time = 0
value = IfElse(Var(8) = 0,191,192)

[State 190, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

