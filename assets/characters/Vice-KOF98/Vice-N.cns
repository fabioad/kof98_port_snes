type = S
ctrl = 0
anim = 184
velset = 0,0,0

[State 184,0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 184,PlaySnd]
type = PlaySnd
trigger1 = Time = 36
value = 184, 0

[State 184,4]
type = AssertSpecial
trigger1 = Time = [0,200]
