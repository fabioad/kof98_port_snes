trigger1 = AnimElem = 2
value = 191, 0

[State 191,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 11
value = 191, 1

[State 191,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 12, = 63;18
value = 191, 2

[State 191,5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

