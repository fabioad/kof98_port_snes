type = S
ctrl = 0
anim = 182
velset = 0,0,0

[State 182,1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 182,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5
value = 182, 0

[State 182,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 8
value = 182, 1

[State 182,3]
type = AssertSpecial
trigger1 = Time = [0,240]
flag = RoundNotOver

;-------------------------------------------------------------------------------
; 勝利３
[Statedef 183]
type = S
ctrl = 0
anim = 183
velset = 0,0,0

[State 183,0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 183,PlaySnd]
