trigger1 = Gethitvar(ChainID)=3010
value = SCA
time = 1
ignorehitpause =1

[State 5050, 6]
type = Selfstate
triggerall = Hitshakeover
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100

