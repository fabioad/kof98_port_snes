value = 185

[State 180,ChangeState]
type = ChangeState
trigger1 = Command = "hold_z"
value = 186

[State 180,ChangeState]
type = ChangeState
trigger1 = Command = "hold_c"
value = 186

[State 180,ChangeState]
type = ChangeState
trigger1 = Time = 1
value = IfElse((Var(2) = [0,199]),181,IfElse((Var(2) = [200,399]),182,IfElse((Var(2) = [400,599]),184,IfElse((Var(2) = [600,799]),185,186))))

