[Statedef 3000]
type = S
movetype = A
physics = S
velset = 0, 0
ctrl = 0
anim = 3000
poweradd = -(PrevStateNo >= 1000) * 1000
juggle = IfElse(PrevStateNo >= 1000,7,8)

