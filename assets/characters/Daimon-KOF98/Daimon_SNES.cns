triggerall = var(59) = 1
triggerall =!ishelper
triggerall = NumEnemy
triggerall = NumHelper(30100+ID)
triggerall = statetype != A
triggerall = MoveType != H
trigger1 = p2Stateno = Helper(30100+ID),var(10)
