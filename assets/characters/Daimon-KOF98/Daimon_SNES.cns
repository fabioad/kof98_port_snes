trigger1 = Time = GetHitVar(ctrltime)
value = 1

[State 153, 5]
type = NotHitBy
trigger1 = HitOver
trigger2 = Time = GetHitVar(ctrltime)
value = SCA
time = 1
persistent = 0

[State 153, Hi to Lo]
