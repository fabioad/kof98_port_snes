trigger1 = AnimElem = 1
trigger1 = Random <= 500
value = s10,2
channel = 0

[State 400, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 2
value = s0,0

[State 400, ヒット定義]
