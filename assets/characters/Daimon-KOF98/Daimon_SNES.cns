;---------------------------------------------------------------------------
; イントロ分岐
; CNS レベル: 基本
;
; ここでは変数(var)を使っていますが、詳しい説明は後ほど。
; VarRandomはrangeで指定された範囲からひとつを選ぶので、
; いろいろな分岐に便利です。

;イントロ選択
[Statedef 190]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 190, VarRandom]
type = VarRandom
trigger1 = 1
v = 0
range = 0,1

[State 190, 対京・紅丸]
type = ChangeState
trigger1 = p2name = "kyo" || p4name = "kyo"
trigger2 = p2name = "kyo kusanagi" || p4name = "kyo kusanagi"
trigger3 = p2name = "cvskyo" || p4name = "cvskyo"
trigger4 = p2name = "Benimaru Nikaido" || p4name = "Benimaru Nikaido"
trigger5 = p2name = "Benimaru" || p4name = "Benimaru"
trigger6 = p2name = "cvsbenimaru" || p4name = "cvsbenimaru"
value = 194

[State 190, ステート変更]
type = ChangeState
triggerall = time = 1
trigger1 = var(0) = 0
trigger1 = prevstateno != 5902
value = 191

[State 190, ステート変更]
type = ChangeState
triggerall = time = 1
trigger1 = var(0) = 1
trigger2 = prevstateno = 5902
value = 193

;---------------------------------------------------------------------------
; イントロ（試合開始直前のアクション）
; CNS レベル: 基本

[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191, 特殊効果] ;「ROUND1, FIGHT!」のアナウンスが始まるまでは、このコントローラを使ってください
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態になります

[State 191, 特殊効果]
type = AssertSpecial
trigger1 = numexplod(78000) = 1
flag = nobardisplay

[State 191, ChangeAnim]
type = ChangeAnim
trigger1 = RoundNo = 1
trigger1 = Time <= 48
value = 191
Elem = 1

[State 191, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 6
value = s12,0

[State 191, 道着]
type = Helper
trigger1 = animelem = 11
id = 3000
name = "hit"
pos = 0,0
postype = p1
stateno = 192
helpertype = normal
pausemovetime = 0
keyctrl = 0 
ownpal = 1

[State 191, ステート変更]
type = ChangeState
trigger1 = AnimElemTime(14) >= 4
trigger1 = numhelper(7600) = 0
value = 0

;----------------------------------------------------------------------------
;(HELPER)道着
[Statedef 192]
type = A
ctrl = 0
anim = 192
velset = 0,0
movetype = I
physics = N
sprpriority = -5

[state a]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[state a]
type = VarSet
trigger1 = time = 0
v = 1
value = 0

[state a]
type = VarAdd
trigger1 = time >= 12
v = 1
value = 22

[state 192, 透過]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256-var(1), var(1)

[state a]
type = destroyself
trigger1 = time = 24

