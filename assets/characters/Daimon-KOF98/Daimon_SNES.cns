; 勝利メッセージ
; CNS レベル: 基本

[Statedef 189]
type = S
ctrl = 0
anim = 9999
velset = 0,0

[State 3000, Super A]
type = palfx
trigger1 = time = 0
add = 0,0,0
time = 1

[State 189, PlaySnd]
