;---------------------------------------------------------------------------
;(HELPER)レイジングストーム・ヘルパー
[Statedef 3001]
type     = A
movetype = A
physics  = N
ctrl     = 0
anim     = 3005
sprpriority = 5

[State 3001, VelSet]
type = Null
triggerall = Time = 0
trigger1 = IsHelper(3000)
trigger1 = var(1) := 1
trigger2 = IsHelper(3020)
trigger2 = var(1) := 2

[State 3001, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 3001, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoShadow ;影を消す

[State 3001, BindToRoot]
type = BindToRoot
trigger1 = 1
pos = -16, 0

[State 3001, AirGuard]
type = AssertSpecial
trigger1 = p2statetype = A
trigger1 = enemy,Vel X > 0
flag = unguardable

[State 3001, AttackDist]
type = AttackDist
trigger1 = 1
value = 160

[State 3001, DM/SDM Flash]
type = EnvColor
trigger1 = movehit = 1
time = 1
value = 255,255,255
under = 1

[State 3001, ヒット定義]
type = HitDef
triggerall = var(1) = 1
triggerall = Root,var(12) = 0
triggerall =!movecontact && !movereversed
trigger1 = AnimElemTime(2) >= 0
attr = A, HP
damage    = floor(((36-root,var(21))*root,fvar(7))*root,fvar(0)),floor(1*root,fvar(7))
getpower  = 0
givepower = floor(1*root,fvar(8)),floor(1*root,fvar(8))
animtype  = Up
guardflag = M
hitflag   = MAFP
priority  = 4, Hit
pausetime = 0,13
guard.pausetime = 0,11
sparkno = s6005
guard.sparkno = s6012
sparkxy = -20,-60+(floor(p2bodydist Y))
hitsound = s1,4
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -4.5-ifelse(Root,var(40),0.5,0),-6.5-ifelse(Root,var(40),0.5,0)
guard.velocity = -10.5-ifelse(Root,var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -4.5-ifelse(Root,var(40),0.5,0),-6.5-ifelse(Root,var(40),0.5,0)
airguard.velocity = -4-ifelse(Root,var(40),0.5,0),-1-ifelse(Root,var(40),0.5,0)
fall.yvelocity = -3.5
yaccel = .5
fall = 1
fall.recover = 0
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
p2stateno = 5630

[State 3001, ヒット定義]
type = HitDef
triggerall = var(1) = 2
triggerall = Root,var(12) = 0
triggerall =!movecontact && !movereversed
trigger1 = AnimElemTime(2) >= 0
attr = A, HP
damage    = floor(((60-root,var(21))*root,fvar(7))*root,fvar(0)),floor(1*root,fvar(7))
getpower  = 0
givepower = floor(1*root,fvar(8)),floor(1*root,fvar(8))
