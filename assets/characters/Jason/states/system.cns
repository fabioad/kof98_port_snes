; Jason Duval -- KOF'98 system states: MAX, charge, CD, rolls, ukemi, intros, wins (generated by tools/cnsgen.py)

[Statedef -2] ; always

[State -2, MAX timer]
type = VarAdd
trigger1 = var(50) > 0
ignorehitpause = 1
var(50) = -1

[State -2, MAX off at round end]
type = VarSet
trigger1 = RoundState != 2 && var(50)
var(50) = 0

[State -2, MAX damage]
type = AttackMulSet
trigger1 = 1
value = ifelse(var(50) > 0, 1.25, 1)
ignorehitpause = 1

[State -2, clean old MAX aura]
type = RemoveExplod
trigger1 = NumExplod(60)
id = 60
ignorehitpause = 1

[State -2, charge aura off]
type = RemoveExplod
trigger1 = NumExplod(65) && (StateNo != 760 || !alive)
id = 65
ignorehitpause = 1

[State -2, MAX glow]
type = PalFX
trigger1 = var(50) > 0 && GameTime % 40 = 0
time = 20
add = 20, 30, 70
sinadd = 20, 20, 40, 20

[State -2, MAX end puff]
type = Explod
trigger1 = var(50) = 1
anim = 6030
pos = 0, -60
postype = p1
removetime = -2
sprpriority = 3
ownpal = 1

[State -2, hurt1]
type = PlaySnd
trigger1 = Time = 1 && StateNo = [5000, 5099] && GetHitVar(damage) < 70 && random % 2 = 0
value = 11,0
channel = 1

[State -2, hurt2]
type = PlaySnd
trigger1 = Time = 1 && StateNo = [5000, 5099] && GetHitVar(damage) < 70 && random % 2 = 1
value = 11,3
channel = 1

[State -2, hurt big1]
type = PlaySnd
trigger1 = Time = 1 && StateNo = [5000, 5099] && GetHitVar(damage) >= 70 && random % 2 = 0
value = 11,1
channel = 1

[State -2, hurt big2]
type = PlaySnd
trigger1 = Time = 1 && StateNo = [5000, 5099] && GetHitVar(damage) >= 70 && random % 2 = 1
value = 11,4
channel = 1

[State -2, hurt fall]
type = PlaySnd
trigger1 = Time = 1 && StateNo = 5100 && random < 600
value = 11,2
channel = 1


[Statedef 180] ; win select
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 180, pick]
type = ChangeState
trigger1 = Time = 0
value = 181 + (random % 3)


[Statedef 100] ; run
type = S
movetype = I
physics = S
anim = 100
ctrl = 0
sprpriority = 2

[State 100, snd]
type = PlaySnd
trigger1 = Time = 0
value = 1,0
channel = -1

[State 100, go]
type = VelSet
trigger1 = 1
x = 7

[State 100, allow attacks]
type = CtrlSet
trigger1 = Time = 1
value = 1

[State 100, no walk]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, no turn]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, dust]
type = Explod
trigger1 = AnimElem = 1
anim = 6040
pos = -8, 0
postype = p1
removetime = -2
sprpriority = -2
ownpal = 1

[State 100, run jump]
type = ChangeState
trigger1 = command = "holdup" && Time > 2
value = 40

[State 100, stop]
type = ChangeState
trigger1 = command != "holdfwd"
trigger2 = FrontEdgeBodyDist < 24
trigger3 = command = "holddown"
value = 0
ctrl = 1


