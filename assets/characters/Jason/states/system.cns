[Statedef 760] ; power charge
type = S
movetype = I
physics = S
anim = 760
ctrl = 0
velset = 0,0

[State 760, aura]
type = Explod
trigger1 = Time = 0
anim = 6065
ID = 65
pos = 0, 0
postype = p1
bindtime = -1
removetime = -1
sprpriority = -1
ownpal = 1
removeongethit = 1

[State 760, PlaySnd]
type = PlaySnd
trigger1 = Time % 36 = 0
value = 3,1
channel = 2
lowpriority = 1

[State 760, PowerAdd]
type = PowerAdd
trigger1 = Time > 4 && power < powermax
value = 9

[State 760, aura off]
type = RemoveExplod
trigger1 = var(59) = 0 && Time > 6 && !(command = "hold_x" && command = "hold_y" && command = "hold_a")
trigger2 = var(59) && (Time > 50 + var(58) * 8 || p2bodydist x < 70)
trigger3 = power >= powermax
id = 65

[State 760, release]
type = ChangeState
trigger1 = var(59) = 0 && Time > 6 && !(command = "hold_x" && command = "hold_y" && command = "hold_a")
trigger2 = var(59) && (Time > 50 + var(58) * 8 || p2bodydist x < 70)
trigger3 = power >= powermax
value = 0
ctrl = 1


