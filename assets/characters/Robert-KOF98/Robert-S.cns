trigger1 = AnimElem = 5
value = s10,20
channel = 0

[State 1000, ヘルパーを出す]
type = Helper
trigger1 = AnimElem = 6,= 1
stateno = 1001
id = 1000
name = "Proj"
pos = 0, 0
postype = P1
helpertype = normal
keyctrl = 0
ownpal = 1

[State 1000, MoveType]
type = StateTypeSet
trigger1 = AnimElem = 12
MoveType = I

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

