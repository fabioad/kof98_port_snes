trigger1 = AnimElem = 14
value = s12,7

[State 3000, PosAdd]
type = PosAdd
trigger1 = AnimElem = 6
trigger2 = AnimElem = 54 || AnimElem = 55 || AnimElem = 56 || AnimElem = 57
