;---------------------------------------------------------------------------
; ここからは超必殺技のステート
;---------------------------------------------------------------------------
; 弱外式・駆け鳳燐

[Statedef 3000]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = 0
velset   = 0,0
anim     = 3000
ctrl     = 0
sprpriority = 2
facep2 = 1

[State 3000, パワーゲージ消費]
type = poweradd
trigger1 = var(40) = 0
trigger1 = time = 0
value = -1000

[State 3000, パワーMAX解除]
type = varset
trigger1 = time = 0
v = 40
value = 0

[State 3000, 無敵]
type = NotHitBy
trigger1 = AnimElemTime (1) >= 0 && AnimElemTime (3) < 0
value = SCA

[State 3000, 超必殺技発動の時間停止]
type = SuperPause
trigger1 = AnimElem = 1
trigger1 = var(11) := 1
anim = -1
time = 28
movetime = 28
darken = 0
p2defmul = 1.0

[State 3000, 超必殺技発動のエフェクト表示]
type = Helper
trigger1 = AnimElem = 1
name = "DM"
stateno = 7000
id = 7000
pos = 10,-92
postype = p1
helpertype = normal
ownpal = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
persistent = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
value = s5,0
channel = 5

[State 3000, 残像]
type = AfterImage
trigger1 = AnimElem = 3
time = 2
palcolor = 0
paladd = 60,20,100
PalContrast = 220,200,350
Trans = none
TimeGap  = 1
FrameGap = 3
length = 11
ignorehitpause = 1

[State 3000, fterimagetime]
type = Afterimagetime
trigger1 = AnimElemTime(3) >= 0
trigger1 = gametime%2 = 0
time = 2

[State 3000, VelSet]
type = VelSet
trigger1 = AnimElem = 3
x = 8

[State 3000, VarSet]
type = VarSet
trigger1 = time = 0
var(16) = 0

[State 3000, VarSet]
type = VarSet
trigger1 = AnimElemTime (3) > 0
trigger1 = var(59) != 1
trigger1 = command = "x" || command = "y"
trigger2 = var(59) = 1
var(16) = 1

[State 3000, ChangeState]
type = ChangeState
triggerall = AnimElemTime (3) > 0
trigger1 = p2bodydist X <= 60 || var(16) = 1
trigger2 = Time = 54
value = 3001

[Statedef 3001]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = 0
;velset   = 0,0
anim     = 3001
ctrl     = 0
sprpriority = 5

[State 3000, fterimagetime]
type = Afterimagetime
trigger1 = AnimElemTime(1) >= 0 && AnimElemTime(5) < 0
trigger1 = gametime%2 = 0
time = 2

[State 3001, 音を鳴らす]
type = StopSnd
trigger1 = Time = 0
channel = 5

[State 3001, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
value = s10,13
channel = 0

[State 3001, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
value = s0,2

[State 3001, VelMul]
type = VelMul
trigger1 = AnimElemTime (8) >= 0
x = .9

[State 3001, VelSet]
type = VelSet
trigger1 = AnimElem = 5,= 1
x = 0

[State 3001, ヒット定義]
type = HitDef
triggerall = var(12) = 0
triggerall = var(13) = 0 || var(13) >= 10
triggerall =!movecontact && !movereversed
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
attr = S, HA
damage    = floor((ifelse(var(6),44,36)-var(21))*fvar(7)),floor(1*fvar(7))
getpower  = 0
givepower = floor(1*fvar(8)),floor(1*fvar(8))
animtype  = Up
guardflag = M
hitflag = MA
priority  = 4, Hit
pausetime = ifelse(var(7),44,27)+(Helper(40000),var(0)),ifelse(var(7),48,29)
guard.pausetime = 32+(Helper(40000),var(0)),32
sparkno = s6005
guard.sparkno = s6012
sparkxy = -25, -65
hitsound = s12,3
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -2-ifelse(var(40),0.5,0),-12-ifelse(var(40),0.5,0)
guard.velocity = -10.5-ifelse(var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -2-ifelse(var(40),0.5,0),-12-ifelse(var(40),0.5,0)
airguard.velocity = -4-ifelse(var(40),0.5,0),-1-ifelse(var(40),0.5,0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall.yvelocity = -3.5
yaccel = .55
fall = 1
fall.recover = 1
fall.recovertime = 600
envshake.time = 20
envshake.ampl = -8
envshake.freq = 92
envshake.phase = 92
ID = 70

[State 3001, ガードクラッシュ値削り]
type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((17-var(21))*fvar(12))
ignorehitpause = 1
persistent = 0

[State 3001, MoveType]
type = StateTypeSet
trigger1 = AnimElem = 5
MoveType = I

[State 3001, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

