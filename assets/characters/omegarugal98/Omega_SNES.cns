;オメガ・ルガール98

[Data]
life = 1098
attack = 100
defence = 105
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 20     ;Player width (back, ground)
ground.front = 23    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 1
head.pos = 0, -110   ;Approximate position of head
mid.pos = 0, -80    ;Approximate position of midsection

[Velocity]
walk.fwd  = 2.6        ;Walk forward
walk.back = -2.3     ;Walk backward
run.fwd  = 6, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -5.3,-2.8     ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8    ;Neutral jumping velocity (x, y)
jump.back = -2.5,-6    ;Jump back Speed (x, y)
jump.fwd = 2.55,-6       ;Jump forward Speed (x, y)
runjump.back = -3,-9 ;Running jump speeds (opt)
runjump.fwd = 4,-9      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55,-8.1 ;Air jump speeds (opt)
airjump.fwd = 2.5,-8.1    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .45         ;Vertical acceleration
stand.friction = 0.83  ;Friction coefficient when standing
crouch.friction = 0.83 ;Friction coefficient when crouching

