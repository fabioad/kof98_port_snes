[State 5101, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 2]
type = PlaySnd
trigger1 = Time = 0 && Vel Y > 0
value = s6,0

[State 5100, 3]
type = Explod
trigger1 = Time = 0 && Vel Y > 0
anim = 6040 + ifelse(Vel Y > 20,5,0)
postype = P1
pos = 0, 0
sprpriority = -1
ownpal = 1

[State 5100, EnvShake]
