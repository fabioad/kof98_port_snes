trigger4=P2name="Akane Tendo"||P2name="Mariko Konjou"||P2name="SIZUKA"||P2name="Nausicaa"||P2name="Wapiko"||P2name="Onpu Segawa"||P2name="moon"||P2name="Super Sailor Moon"||P2name="Kanaria-D"||P2name="K-ko"||P2name="A_Mizuki"||P2name="Docinho por Ssonic"
