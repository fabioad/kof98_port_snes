[Statedef 200]
type = S
movetype = A
physics = S
poweradd = 20
velset = 0,0
facep2 = 1
ctrl = 0

[State 0,M ChangeAnim]
type = ChangeAnim
trigger1 = (command = "hold_x" || command = "hold_y" || command = "hold_a" || command = "hold_b") && time = 0
value = IfElse(command != "hold_x",IfElse(command!= "hold_a",IfElse(command!= "hold_y",230+var(50),220+var(50)),210),200)
elem = 1

[State 0, VarRandom]
type = VarRandom
trigger1 = time = 0
v = 10
range = 0,2

[State ,PlaySnd]
type = PlaySnd
triggerall = Random < 900
trigger1 = Animelem = 1 && anim = [200,210]
value = S200+(var(50)/5),var(10)
channel = 2
[State ,PlaySnd]
type = PlaySnd
triggerall = Random < 900
trigger1 = Animelem = 1 && (anim = 220||anim=230)
