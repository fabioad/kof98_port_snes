air.velocity = -IfElse(anim=210,2.5,2.1),-9
guard.velocity = -IfElse(anim=210,10,7.5)
ground.cornerpush.veloff = -IfElse(anim=210,10,6.5)
guard.cornerpush.veloff = -IfElse(anim=210,10,6.9)
air.cornerpush.veloff = -IfElse(anim=210,4,2.8)
