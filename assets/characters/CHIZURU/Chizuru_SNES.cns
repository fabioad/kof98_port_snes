trigger1 = Time = 0 && command != "holdup"
value = IfElse(sysvar(1) != 0,IfElse(sysvar(1) <= -1,55,53),51)

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > IfElse((anim=[40,49]),1,0)
value = anim+1
persistent = 0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(5) && ((anim = 2120 && animelem = 13,<0)||anim!=2120)
value = IfElse(PrevStateNo=2100,2120,41)
elem = IfElse(PrevStateNo=2100,13,3)

