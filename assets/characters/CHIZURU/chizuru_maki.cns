; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
velset = 0,0
facep2 = IfElse(command="holddown++",0,1)
;anim = 47

[State 0, NotHitBy]
type = HitBy
trigger1 = var(5)
value = SCA
time = 10
[State 0, Trans]
type = Trans
trigger1 = var(5) = 1
trans = add1
alpha = 0,265

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0; && !var(5)
value = 47,1
freqmul = IfElse(sysvar(1)=2||sysvar(1)=-2,1.1,0.9)

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = 47

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 1 && !var(5)
value = 1

[State 52, 4]
