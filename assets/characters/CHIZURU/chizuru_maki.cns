; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
;ctrl = 0
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = animelem = 2,>0
x = const(velocity.run.fwd.x)

[State 0, VelAdd]
type = VelAdd
trigger1 = animelem = 3 || animelem = 6
x = -2

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 105, 2]
type = ChangeState
trigger1 = Command = "holdup"
value = 40
ctrl = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 3 || animelem = 6
value = S100,1
volume = -100
channel = 1
freqmul = 1.35

[State 106, 4]
type = MakeDust
trigger1 = animelem = 3 || animelem = 6
pos = -15,-2
spacing = 1

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd" && time >= 14
value = 101
ctrl = 1

