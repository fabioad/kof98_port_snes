;---------------------------------------------------------------------------
;(HELPER)波動拳・ヘルパー
[Statedef 1020]
type     = A
movetype = A
physics  = N
ctrl     = 0
anim     = 1020
sprpriority = 5

[State 1020, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 1020, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoShadow ;影を消す

[State 1020, VelSet]
type = VelSet
triggerall = time = 0
trigger1 = root,var(15) = 0
x = 4

[State 1020, VelSet]
type = VelSet
triggerall = time = 0
trigger1 = root,var(15) = 1
x = 7

[State 1020, 飛び道具]
type = Projectile
;triggerall = root,var(12) = 0
Trigger1 =!Time
Trigger1 = Root,NumProjID(1000) = 0
Trigger2 = Root,NumProjID(1000) = 1
attr = A, SP
projID = 1000
projanim = 1025
projhitanim = -1
projscale = 1, 1
projremove = 1
projremovetime = 1
velocity = Vel X, Vel Y
projhits = ifelse((Root,var(11) || Root,var(12)),0,1)
projmisstime = 1
projpriority = 1
ProjEdgeBound = 80
offset = 0, 0
postype = p1
damage    = floor(((ifelse(root,var(6),20,16)-root,var(21))*root,fvar(7))*root,fvar(0)),floor(1*root,fvar(7))
getpower  = floor(5*root,fvar(8)),floor(5*root,fvar(8))
givepower = floor(1*root,fvar(8)),floor(1*root,fvar(8))
animtype  = Hard
air.animtype = back
guardflag = MA
hitflag = MAF
priority  = 4, Hit
pausetime = 0,13
guard.pausetime = 0,11
sparkno = s6002+ifelse(root,var(40),3,0)
guard.sparkno = s6012
sparkxy = 0, 13
hitsound = s1,1
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -10.5-ifelse(var(40),0.5,0)-ifelse(Root,var(40),0.5,0)
guard.velocity = -10.5-ifelse(Root,var(40),0.5,0)
airguard.velocity = -4-ifelse(Root,var(40),0.5,0),-1-ifelse(Root,var(40),0.5,0)
air.type = High
air.velocity = -4.5-ifelse(Root,var(40),0.5,0),-6.5-ifelse(Root,var(40),0.5,0)
air.hittime = 12
fall.yvelocity = -3.5
yaccel = .5
air.fall = 1
fall.recover = 1
fall.recovertime = 600

[State 1020, このヘルパーを消す]
type = DestroySelf
trigger1 = time >= 300
trigger2 = frontedgedist <= -80

[State 1020, ステート変更]
type = ChangeState
Triggerall = Time
Trigger1 = Root,NumProjID(1000) = 0
value = 1021

[Statedef 1021]
type     = A
movetype = A
physics  = N
juggle   = 0
poweradd = 0
velset   = 0,0
anim     = 9999
ctrl     = 0
sprpriority = 5

[State 1021, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 1021, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 1021, エフェクト表示]
type = Explod
trigger1 = time = 0
anim = 1021
postype = P1
pos = 0, 0
persistent = 0
sprpriority = 5
ownpal = 1

[State 1021, このヘルパーを消す]
type = DestroySelf
trigger1 = Time = 2

