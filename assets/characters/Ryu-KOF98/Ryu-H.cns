;(HELPER)真空波動拳・ヘルパー
[Statedef 3020]
type     = A
movetype = A
physics  = N
ctrl     = 0
anim     = 3020
sprpriority = 5

[State 3020, リセット]
type = VarSet
trigger1 = Time = 0
var(1) = 1

[State 3020, ヒット数]
type = VarAdd
;triggerall = RoundState = 2
;triggerall = p2movetype = H
trigger1 = MoveContact = 1 || MoveReversed = 1
var(1) = 1

[State 3020, 半数補正]
type = ParentVarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = root,var(6) = 0
trigger1 = MoveContact = 1
var(23) = 1

[State 3020, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 3020, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoShadow ;影を消す

[state 3020, VelSet]
type = VelSet
trigger1 = time = 0
trigger1 = root,var(15) = 0
x = 5

[state 3020, VelSet]
type = VelSet
trigger1 = time = 0
trigger1 = root,var(15) = 1
x = 8

[State 3020, DM/SDM Flash]
type = EnvColor
trigger1 = MoveHit = 1
time = 1
value = 255,255,255
under = 1

[State 3020, PosFreeze]
type = PosFreeze
trigger1 = MoveContact = 1 || MoveReversed = 1

[State 3020, PosFreeze]
type = SprPriority
trigger1 = 1
value = 5
ignorehitpause = 1

[State 3020, ヒット定義]
type = HitDef
trigger1 = root,var(12) = 0
attr = A, HP
damage    = floor((((18-root,var(21))/root,var(23))*root,fvar(7))*root,fvar(0)),floor(1*root,fvar(7))
getpower  = 0
givepower = floor(1*root,fvar(8)),floor(1*root,fvar(8))
animtype  = Hard
air.animtype = back
guardflag = M
hitflag = MAF
priority  = 4, Hit
pausetime = 3+(Helper(40000),var(0)),13
guard.pausetime = 3+(Helper(40000),var(0)),11
sparkno = s6005
guard.sparkno = s6012
sparkxy = 0, 13
hitsound = s1,ifelse(var(1)>=3,4,1)
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -4.5-ifelse(Root,var(40),0.5,0),-6.5-ifelse(Root,var(40),0.5,0)
guard.velocity = -10.5-ifelse(Root,var(40),0.5,0)
airguard.velocity = -4-ifelse(Root,var(40),0.5,0),-1-ifelse(Root,var(40),0.5,0)
air.type = High
air.velocity = -4.5-ifelse(Root,var(40),0.5,0),-6.5-ifelse(Root,var(40),0.5,0)
air.hittime = 12
fall = 1
fall.recover = 1
fall.recovertime = 600
fall.yvelocity = -3.5
yaccel = .5

[State 3020, 飛び道具(相殺用)]
type = Projectile
Trigger1 =!Time
Trigger1 = Root,NumProjID(3000) = 0
Trigger2 = Root,NumProjID(3000) = 1
projID = 3000
projanim = 3025
projhitanim = -1
projscale = 1, 1
projremove = 1
projremovetime = 1
velocity = Vel X, Vel Y
projpriority = 3
ProjEdgeBound = 80
offset = 0, 0
ignorehitpause = 1

[State 3020, ジャグル設定]
type = ParentVarSet
trigger1 = movehit = 1
var(13) = ifelse(Root,var(6) >= 1,18,13)
[State 3020, ジャグル設定]
type = ParentVarSet
trigger1 = movehit = 1
var(14) = 0

[State 3020, 投げ制限1]
type = ParentVarSet
trigger1 = movecontact = 1
var(17) = 6
[State 3020, 投げ制限2]
type = ParentVarSet
trigger1 = movecontact = 1
var(18) = 2

[State 3020, スロー処理]
type = ParentVarSet
trigger1 = movehit = 1
var(31) = 1

[State 3020, ガード弾き値削り]
type = ParentVarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((4-root,var(21))*root,fvar(12))

[State 3020, ガード弾き値回復不能時間]
type = ParentVarSet
triggerall = Root,fvar(11) != 300
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(11) = 300

[State 3020, 気絶値回復不能時間]
type = ParentVarSet
triggerall = root,fvar(13) != 120
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = movecontact = 1
fvar(14) = 120

[State 3020, このヘルパーを消す]
type = DestroySelf
trigger1 = time >= 300
trigger2 = frontedgedist <= -80

[State 3020, ステート変更]
type = ChangeState
Trigger1 = var(1) > 3
Trigger2 = Time
Trigger2 = Root,NumProjID(3000) = 0
value = 3021

