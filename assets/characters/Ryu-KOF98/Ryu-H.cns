;---------------------------------------------------------------------------
; ここからは超必殺技のステート
;---------------------------------------------------------------------------
; 弱真空波動拳

[Statedef 3000]
type     = S
movetype = A
physics  = N
juggle   = 0
velset   = 0,0
anim     = 3000 + (var(7) = 1)
ctrl     = 0
sprpriority = 2
poweradd = 0
facep2 = 1

[State 3000, VarSet]
type = VarSet
trigger1 = time = 0
var(15) = 0

[State 3000, 半数補正]
type = VarSet
trigger1 = time = 0
var(23) = 1

[State 3000, パワーゲージ消費]
type = poweradd
trigger1 = var(40) = 0
trigger1 = time = 0
value = -1000

[State 3000, パワーMAX解除]
type = VarSet
trigger1 = time = 0
v = 40
value = 0

[State 3000, 無敵]
type = NotHitBy
trigger1 = AnimElemTime(1) >= 0 && AnimElemTime(5) < 0
value = SCA

[State 3000, 残像]
type = AfterImage
trigger1 = time = 0
time = 1

[State 3000, 超必殺技発動の時間停止]
type = SuperPause
trigger1 = AnimElem = 1
trigger1 = var(11) := 1
anim = -1
time = 28
movetime = 28
darken = 0
p2defmul = 1.0

[State 3000, 超必殺技発動のエフェクト表示]
type = Helper
trigger1 = AnimElem = 1
name = "DM"
stateno = 7000
id = 7000
pos = -15,-70;-25,-71
postype = p1
helpertype = normal
ownpal = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
persistent = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s10+(var(8)*10),25
channel = 0

[State 3000, エフェクト表示]
type = Explod
trigger1 = AnimElem = 1
anim = 9999
ID = 3099
postype = P1
pos = 0, 0
removetime = 48
sprpriority = 5
ownpal = 1
supermove = 1
removeongethit = 1

[State 3000, 音を鳴らす]
type = PlaySnd
Trigger1 = AnimElemtime(7) >= 0
trigger1 = NumExplod(3099) = 0
value = s10+(var(8)*10),20
channel = 0
persistent = 0

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 5
value = s12,0

[State 3000, ヘルパーを出す]
