triggerall = RoundState = 2
triggerall = p2movetype = H
triggerall = fvar(15) = 0
trigger1 = movehit = 1
fvar(13) = floor((18-var(21))*fvar(16))
ignorehitpause = 1
persistent = 0

[State 640, MoveType]
