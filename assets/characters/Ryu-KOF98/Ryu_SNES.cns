; ===== from Config.cns =====

;-----------------------------------------------------------------------------
;設定項目
;-----------------------------------------------------------------------------
[Statedef 40000]
anim = 9999
ctrl = 0

;-----------------------------------------------------------------------------
;本体システム設定
;-----------------------------------------------------------------------------
; ADV／EXモード設定時間設定
;  var(1)の数値を任意の値に変更して下さい。単位は秒です。
;  デフォルトはvar(1) = 5(5秒)。

[State 40000, Mode Setting Time]
type = VarSet
trigger1 = 1
var(1) = 5 ;(*sec)

;---------------------------------------------------------------------------
; モーションの設定
;  var(3) = 0 : 原作準拠
;  var(3) = 1 : ニュートラルと波動拳の動作が変化

[State 40000, Motion(Stance, Hadou Ken)]
type = VarSet
trigger1 = 1
var(3) = 1
;(0:Original 1:Arrange)

;---------------------------------------------------------------------------
; ガードクラッシュゲージ・スタンゲージの表示
;  var(4) = 0 : 表示しない
;  var(4) = 1 : 表示する

[State 40000, Crash & Stun Mater]
type = VarSet
trigger1 = 1
var(4) = 1
;(0:Not Display 1:Display)

;---------------------------------------------------------------------------
; ガードクラッシュゲージ・スタンゲージの位置の設定
;  var(5)とvar(6)の数値を任意の値に変更して下さい。

[State 40000, Item Setting - Position X]
type = VarSet
trigger1 = 1
var(5) = 231 ;(+:Front, -:Back)

[State 40000, Item Setting - Position Y]
type = VarSet
trigger1 = 1
var(6) = 37 ;(+:Down, -:Up)

;---------------------------------------------------------------------------
; 待機メンバーの表示
;  var(10) = 0 : 非表示
;  var(10) = 1 : 表示

[State 40000, Display Reserve Member]
Type = VarSet
Trigger1 = 1
var(10) = 1
;(0:Disable 1:Enable)

