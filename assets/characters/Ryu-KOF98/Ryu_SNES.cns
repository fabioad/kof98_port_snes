trigger1 = Vel X > 0
trigger1 = PrevStateNo != 55
var(25) = ifelse(var(6),14,11)

[State 640, VarSet]
type = VarSet
trigger1 = Vel X < 0
trigger2 = PrevStateNo = 55
var(25) = ifelse(var(6),14,11)

[State 640, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = Random <= 500
value = s10+(var(8)*10),11
channel = 0

[State 640, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 2
value = s0,1

[State 640, ヒット定義]
type = HitDef
triggerall = var(12) = 0
triggerall =!movecontact && !movereversed
trigger1 = Anim = 640 && AnimElemTime(3) >= 0 && AnimElemTime(4) < 0
trigger1 = var(28) := 1
trigger2 = Anim = 645 && AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger2 = var(28) := 1
attr = A, NA
damage    = floor((var(25)-var(21))*fvar(7)), 0
getpower  = floor(ifelse(var(40),0,7)*fvar(8)),floor(ifelse(var(40),0,7)*fvar(8))
givepower = floor(1*fvar(8)),floor(1*fvar(8))
animtype  = Medium
air.animtype = back
guardflag = HA
hitflag   = MAF
priority  = 4, Hit
pausetime = 11+(Helper(40000),var(0)),13
guard.pausetime = 11+(Helper(40000),var(0)),11
sparkno = s6001+ifelse(var(40),3,0)
guard.sparkno = s6011
sparkxy = -12, ifelse(Anim = 645,-51,-80)
hitsound   = s1,3
guardsound = s2,0
ground.type = Low
ground.slidetime = 9
ground.hittime = 9
ground.velocity = -6-ifelse(var(40),0.5,0)
guard.slidetime = 17
guard.hittime = 17
guard.velocity = -10.5-ifelse(var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
airguard.velocity = -4-ifelse(var(40),0.5,0),-1-ifelse(var(40),0.5,0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall.yvelocity = -3.5
yaccel = .5
ID = 10

[State 640, ガードクラッシュ値削り]
type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((17-var(21))*fvar(12))
ignorehitpause = 1
persistent = 0

[State 640, スタン値削り]
