fvar(1) = 0

[State -2, 横タメ解除猶予]
type = VarAdd
trigger1 = command != "holdback"
fvar(2) = 1

[State -2, 横タメ解除猶予解除]
type = VarSet
trigger1 = command = "holdback"
fvar(2) = 0

[State -2, 横タメ成立]
type = VarSet
trigger1 = fvar(1) >= 30
fvar(3) = 24

[State -2, 横タメ成立解除]
type = VarAdd
trigger1 = fvar(1) < 30 && fvar(3) > 0
fvar(3) = -1

