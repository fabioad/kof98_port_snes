;---------------------------------------------------------------------------
; イントロ分岐
; CNS レベル: 基本
;
; ここでは変数(var)を使っていますが、詳しい説明は後ほど。
; VarRandomはrangeで指定された範囲からひとつを選ぶので、
; いろいろな分岐に便利です。

;イントロ選択
[Statedef 190]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 190, 特殊掛け合い]
type = ChangeState
trigger1 = enemy,name = "Ken Masters" && EnemyNear,AuthorName = "ikaruga"
value = 192

[State 190, 特殊掛け合い]
type = ChangeState
trigger1 = enemy,name = "Kyo Kusanagi" 
trigger1 = Enemy,AuthorName = "ikaruga" || Enemy,AuthorName = "Soy Sauce"
value = 990

[State 190, ChangeState]
type = ChangeState
trigger1 = 1
value = 191

;---------------------------------------------------------------------------
; イントロ（試合開始直前のアクション）
; CNS レベル: 基本

[Statedef 191]
type = S
ctrl = 0
anim = 0 + (var(7) = 1);191
velset = 0,0

[State 191, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 191, 特殊効果] ;「ROUND1, FIGHT!」のアナウンスが始まるまでは、このコントローラを使ってください
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態になります

[State 191, 特殊効果]
type = AssertSpecial
trigger1 = numexplod(78000) = 1
flag = nobardisplay

[State 191, ChangeAnim]
type = ChangeAnim
trigger1 = RoundNo = 1 && (Time = [0,48])
value = 0 + (var(7) = 1)

[State 191, ChangeAnim]
type = ChangeAnim
trigger1 = RoundNo = 1 && Time = 49
trigger2 = RoundNo != 1 && Time = 0
value = 191
Elem = 2

[State 191, 音を鳴らす]
type = PlaySnd
trigger1 = Anim = 191 && AnimElem = 4
value = s10,1

[State 191, ステート変更]
type = ChangeState
trigger1 = Anim = 191 && AnimTime = 0
value = 199

