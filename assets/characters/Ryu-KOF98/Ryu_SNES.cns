;==============================================================================
; ふっとばし攻撃

[Statedef 250]
type     = S
movetype = A
physics  = N
juggle   = 0
PowerAdd = 0
ctrl     = 0
velset   = 0,0
anim     = 250
sprpriority = 3
facep2 = 1

[State 250, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s10+(var(8)*10),23
channel = 0

[State 250, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 6
value = s0,1

[State 310, 軸位置移動]
type = PosAdd
trigger1 = AnimElem = 2 || AnimElem = 3 || AnimElem = 4 || AnimElem = 5
trigger2 = AnimElem = 6 || AnimElem = 7 || AnimElem = 10 || AnimElem = 11
x = 8

[State 250, ヒット定義]
type = HitDef
triggerall = var(12) = 0
triggerall =!movecontact && !movereversed
trigger1 = AnimElemTime(7) >= 0 && AnimElemTime(8) < 0
trigger1 = var(28) := 1
attr = S, NA
damage    = floor((ifelse(var(6),22,18)-var(21))*fvar(7)), 0
getpower  = floor(ifelse(var(40),0,9)*fvar(8)),floor(ifelse(var(40),0,9)*fvar(8))
givepower = floor(1*fvar(8)),floor(1*fvar(8))
animtype  = Hard
air.animtype = back
guardflag = M
hitflag = MAF
priority  = 4, Hit
pausetime = 11+(Helper(40000),var(0)),13
guard.pausetime = 11+(Helper(40000),var(0)),11
sparkno = s6001+ifelse(var(40),3,0)
guard.sparkno = s6011
sparkxy = -24, -68
hitsound = s1,4
guardsound = s2,0
ground.type = High
ground.slidetime = 21
ground.hittime = 21
ground.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
guard.velocity = -10.5-ifelse(var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
airguard.velocity = -4-ifelse(var(40),0.5,0),-1-ifelse(var(40),0.5,0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall = 1
fall.recover = 1
fall.recovertime = 600
fall.yvelocity = -3.5
yaccel = .5
ID = 30

[State 250, ガードクラッシュ値削り]
type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((15-var(21))*fvar(12))
ignorehitpause = 1
persistent = 0

[State 250, スタン値削り]
type = VarAdd
triggerall = RoundState = 2
triggerall = p2movetype = H
triggerall = fvar(15) = 0
trigger1 = movehit = 1
fvar(13) = floor((21-var(21))*fvar(16))
ignorehitpause = 1
persistent = 0

[State 250, MoveType]
type = StateTypeSet
trigger1 = AnimElem = 8
MoveType = I

[State 250, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

