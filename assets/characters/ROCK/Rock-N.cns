;---------------------------------------------------------------------------
[Statedef 200]
type     = S 
movetype = A 
physics  = S 
juggle   = 8                 ;攻撃を当てた時に溜まるジャグルポイントの設定
velset   = 0,0 
ctrl     = 0  
anim     = 200 
poweradd = 20                ;パワーゲージの増加量を設定
sprpriority = 2 

[State 200, ヒット定義]
type = HitDef 
trigger1 = time = 0 
attr = S, NA  
damage = 23, 0 
animtype = Light 
guardflag = MA 
hitflag = MAF 
priority = 3, Hit 
pausetime = 7, 8  
sparkno = 0 
guard.sparkno = 40 
sparkxy = -10, -85           ;ヒットスパークの位置（Ｘ軸,Ｙ軸）
hitsound = s1,0  
guardsound = s2,0 
ground.type = High 
ground.slidetime = 8         ;当たった時の地上の相手がのけぞる時間
ground.hittime  = 10         ;当たった時の地上の相手のやられ状態の時間
ground.velocity = -4.5,0     ;当たった時の地上の相手の初速度（Ｘ軸,Ｙ軸）
airguard.velocity = -1.9,-.8 ;ガードされた時の空中の相手の初速度 (デフォルト：(air.xvel*1.5, air.yvel/2))
air.type = Low 
air.velocity = -1.4,-3       ;当たった時の空中の相手の初速度（Ｘ軸,Ｙ軸）
air.hittime = 12             ;当たった時の空中の相手のやられ状態の時間

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
trigger1 = random < 600
value = 10,5
channel = 4

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = 0,0

[State 400, コントロール可否]
type = CtrlSet
trigger1 = AnimElem = 6
value = 1

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 0
ctrl = 1

