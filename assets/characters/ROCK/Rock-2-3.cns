params = var(22),var(21),ceil(Pos X),floor(Pos Y)
ignorehitpause = 1

;昞帵傪壓偵壛偊傞
[State -2, 僨僶僢僌昞帵偦偺3]
type = AppendToClipboard
trigger1 = 1
