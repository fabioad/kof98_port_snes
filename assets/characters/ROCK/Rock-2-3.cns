triggerall = StageVar(info.author) = "water"
triggerall = Time = 1
trigger1 = StateNo=52000||StateNo=2615||StateNo=1205
ID = 22
anim = F22
postype = p1
pos = 10,0
ownpal = 1
ontop = 1
bindtime = 1
removetime = -2
pausemovetime = 999999
supermovetime = 999999

[State -3 , 落地声效]
