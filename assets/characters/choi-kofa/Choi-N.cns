; ADD004 BASIC PIEs ReBuilded CNS (30/08/2019)
;==============================================
; This file is Made by PIE.
; there is a backup of this file in the same folder, named "<samename>.a4bk".
; to Restore, use assist tool, or delete this file, then remove ".a4bk" from the neme of backup.
;==============================================

;=====================================================================
;  CNS File For "CHOI BOUNGE"                               Made By H"         
;=====================================================================

;---------------------------------------------------------------------
; 曄悢昞
;僉儍儔僋僞乕梡 var(10-29)
;	var(10) : 慁晽旘墡巋撍梡僇僂儞僞
;	var(11) : 儃僞儞墴偟偭傁側偟敾掕
;	var(12) : 庈巰X幉儔儞僟儉僼儔僌
;	var(13) : 庈巰y幉儔儞僟儉僼儔僌
;	var(14) : 僸僢僩悢僇僂儞僩1
;	var(15) : 僸僢僩悢僇僂儞僩2
;	var(16) : 旘傃摴嬶僸僢僩張棟
;	var(17) : 曽岦揮姺梡
;僨僼僅儖僩僔僗僥儉梡 fvar(1-39)
;	fvar(1) : X幉埵抲寁應
;	fvar(2) : Y幉埵抲寁應
;	fvar(3) : 儃僞儞擖椡僼儔僌
;	fvar(4) : 僉儍儔敾暿僼儔僌
;	fvar(28) : 僗僩儔僀僇乕僗僥乕僩愝掕
;
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 婎杮愝掕
[Data]
life = 1500          ; 懱椡僎乕僕丄忋尷抣乮僨僼僅儖僩丗1000乯
power = 3000
attack = 100         ; 峌寕椡乮亾乯
defence = 100        ; 杊屼椡乮亾乯
fall.defence_up   = 30
liedown.time      = 50
airjuggle = 15        ; 嬻拞僐儞儃
sparkno =    2        ; 弶婜僸僢僩僗僷乕僋斣崋
guard.sparkno =    40 ; 弶婜僈乕僪僗僷乕僋斣崋
KO.echo = 0          ; 俲俷儃僀僗僄僐乕乮0:OFF丄1:ON乯
volume = 255         ; 僉儍儔儃僀僗儃儕儏乕儉抣
IntPersistIndex=30,58,59

[Size]
xscale = 1           ; 悈暯僒僀僘攞棪
yscale = 1           ; 悅捈僒僀僘攞棪
ground.back = 16     ; 僉儍儔暆乮抧忋丄屻傠懁乯
ground.front = 16    ; 僉儍儔暆乮抧忋丄慜懁乯
air.back = 12        ; 僉儍儔暆乮嬻拞丄屻傠懁乯
air.front = 12       ; 僉儍儔暆乮嬻拞丄慜懁乯
z.width = 10         ; 僉儍儔暆乮倸幉乯
height = 40	     ; 僉儍儔偺崅偝乮僕儍儞僾偱旘傃墇偣傞崅偝乯
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 18,-45    ; 摢晹嵗昗
mid.pos = 0,-33     ; 懱拞怱晹嵗昗
shadowoffset = 0     ; 僉儍儔偺塭丒僆僼僙僢僩抣

[Velocity]
walk.fwd  = 4			; 慜恑懍搙
walk.back = -2.5		; 屻戅懍搙
run.fwd  = 6.1, 0		; 慜僟僢僔儏懍搙乮y<0偺応崌丄儂僢僾僗僥僢僾乯
run.back = -8,-4.2		; 僶僢僋僗僥僢僾懍搙乮y=0偺応崌丄憱傝乯
jump.neu = 0,-12		; 悅捈僕儍儞僾懍搙
jump.back = -4.14		; 屻曽僕儍儞僾懍搙
jump.fwd = 4.14		; 慜曽僕儍儞僾懍搙
runjump.back = -6,-14	; 屻曽僕儍儞僾懍搙乮僟僢僔儏拞乯
runjump.fwd = 6,-14		; 慜曽僕儍儞僾懍搙乮僟僢僔儏拞乯
airjump.neu  = 0,-8.1
airjump.back = -4.4
airjump.fwd  = 4.6

[Movement]
airjump.num = 1       ; 嬻拞僕儍儞僾夞悢
airjump.height = 35  ; 嬻拞僕儍儞僾嵟掅崅搙
yaccel = .58           ; 僉儍儔廳椡壛懍搙
stand.friction = .85  ; 杸嶤學悢乮棫偪忬懺乯
crouch.friction = .82 ; 杸嶤學悢乮偟傖偑傒忬懺乯

[Quotes]
victory1 = "You did pretty good Just to last this long."
victory2 = "Winning isn't everything.. It's the only thing, loser!"
victory3 = "Through already? What a gyp!"
;victory10 = "Not bad, little lady. Not bad at all.."
;victory11 = "Nothing like the touch Of youth.. nothing! ah, cha, cha!"
;victory12 = "Whew! that really brings Me back to last year's fun.."
;victory12 = "Whew, man!.. I could use a little tlc.."
;=======================================================================
; Definition of the Basic Action
;=======================================================================
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 191, Spray Anim P1]
type = Explod
trigger1 = time >= 0 && timemod = 10,0
trigger1 = StageVar(info.author) = "water"
ID = 20
anim = F21
postype = p1
pos = -10,0
ownpal = 1
ontop = 1
bindtime = 1
removetime = -2

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.fwd.x)

[State 100,1]
type = PlaySnd
trigger1 = Time = 2
value = F100,0+(StageVar(info.author) = "water")
loop = 1
channel = 2

[State 100,4]
type = ChangeState
trigger1 = Command != "holdfwd" && Time >= 10
value = 101
ctrl = 1

[State 100,5]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

