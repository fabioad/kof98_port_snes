;---------------------------------------------------------------------------
; ここからは必殺技のステート
;---------------------------------------------------------------------------
; 弱飛燕斬

[Statedef 1000]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = floor(7*fvar(8))
velset   = 0,0
anim     = 1000
ctrl     = 0
sprpriority = 3
facep2 = 1

[State 1010, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(10) = 1
value = 1001

[State 1000, 無敵]
type = NotHitBy
trigger1 = Anim = 1000 && AnimElemTime(1) >= 0 && AnimElemTime(3) < 0
trigger2 = Anim = 1001 && AnimElemTime(1) >= 0 && AnimElemTime(4) < 0
value = SCA

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 2
value = s10,20
channel = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = s12,1

[State 1000, PosAdd]
type = PosAdd
trigger1 = Anim = 1000 && (AnimElem = 3 || AnimElem = 5 || AnimElem = 6 || AnimElem = 7)
x = 8

[State 1000, PosAdd]
type = PosAdd
trigger1 = Anim = 1001 && (AnimElem = 3 || AnimElem = 4)
x = 16

[State 1000, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 4
statetype = A

[State 1000, VelSet]
type = VelSet
trigger1 = Anim = 1000
trigger1 = AnimElem = 4
y = -5.5

[State 1000, VelSet]
type = VelSet
trigger1 = Anim = 1001
trigger1 = AnimElem = 4
x = 1
y = -7.5

[State 1000, VelAdd]
type = VelAdd
trigger1 = AnimElemtime(4) > 0
y = .5

[State 1000, Movehitreset]
type = MoveHitReset
trigger1 = Anim = 1000 && AnimElem = 4 || AnimElem = 6 || Anim = 1001 && AnimElem = 7

[State 1000, ヒット定義]
type = HitDef
triggerall = var(12) = 0
triggerall =!movecontact && !movereversed
trigger1 = Anim = 1000 && AnimElemTime(3) >= 0 && AnimElemTime(4) < 0
attr = S, SA
damage    = floor((13-var(21))*fvar(7)),floor(1*fvar(7))
getpower  = floor(3*fvar(8)),floor(3*fvar(8))
givepower = floor(1*fvar(8)),floor(1*fvar(8))
animtype  = Hard
air.animtype = back
guardflag = M
hitflag   = MAF
priority  = 4, Hit
pausetime = 11+(Helper(40000),var(0)),13
guard.pausetime = 11+(Helper(40000),var(0)),11
sparkno = s6002+ifelse(var(40),3,0)
guard.sparkno = s6012
sparkxy = -16, -82
hitsound = s1,4
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
guard.velocity = -10.5-ifelse(var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
airguard.velocity = -4-ifelse(var(40),0.5,0),-1-ifelse(var(40),0.5,0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
yaccel = .5
fall = 1
fall.recover = 1
fall.recovertime = 600
fall.yvelocity = -3.5
ID = 30

