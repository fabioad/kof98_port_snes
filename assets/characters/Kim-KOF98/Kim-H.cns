;---------------------------------------------------------------------------
; ここからは超必殺技のステート
;---------------------------------------------------------------------------
; 鳳凰脚

[Statedef 3000]
type     = U
movetype = A
physics  = N
juggle   = 0
velset   = 0,0
anim     = 3000 + (var(10) = 1)
ctrl     = 0
sprpriority = 2
facep2 = 1

[State 3000, ChangeAnim]
type = ChangeAnim
triggerall = time = 0
trigger1 = StateType = A
value = 3005 + (var(10) = 1)

[State 3000, VarSet]
type = VarSet
trigger1 = time = 0
var(16) = 0

[State 3000, VarSet]
type = VarSet
triggerall = time = 0
trigger1 = var(59) != 1
trigger1 = command = "holdx"
var(16) = 1

[State 3000, パワーゲージ消費]
type = PowerAdd
trigger1 = var(40) = 0
trigger1 = time = 0
value = -1000

[State 3000, パワーMAX解除]
type = VarSet
trigger1 = time = 0
var(40) = 0

[State 3000, 無敵]
type = NotHitBy
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElemTime(1) >= 0 && AnimElemTime(7) < 0
trigger2 = (Anim = 3005 || Anim = 3006) && AnimElemTime(1) >= 0 && AnimElemTime(4) < 0
value = SCA

[State 3000, 超必殺技発動の時間停止]
type = SuperPause
trigger1 = AnimElem = 1,= 1
trigger1 = var(11) := 1
anim = -1
time = 28
movetime = 28
darken = 0
p2defmul = 1.0

[State 3000, 超必殺技発動のエフェクト表示]
type = Helper
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElem = 1
name = "DM"
stateno = 7000
id = 7000
pos = -5, -62
postype = p1
helpertype = normal
ownpal = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
persistent = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

[State 3000, 超必殺技発動のエフェクト表示]
type = Helper
trigger1 = (Anim = 3005 || Anim = 3006) && AnimElem = 1
name = "DM"
stateno = 7000
id = 7000
pos = 4, -74
postype = p1
helpertype = normal
ownpal = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
persistent = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s10,30
channel = 0

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElem = 7
trigger2 = (Anim = 3005 || Anim = 3006) && AnimElem = 4
value = s12,5

[State 3000, StateTypeSet]
type = StateTypeSet
trigger1 = Time = 0
statetype = A
physics = N

[State 3000, VelSet]
type = VelSet
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElem = 7
trigger2 = (Anim = 3005 || Anim = 3006) && AnimElem = 4
x = 10
y = ifelse(var(16) = 1,-1,-2)

[State 3000, VelAdd]
type = VelAdd
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElemTime(7) >= 0
trigger2 = (Anim = 3005 || Anim = 3006) && AnimElemTime(4) >= 0
y = .15

[State 3000, 残像]
type = AfterImage
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElem = 7
trigger2 = (Anim = 3005 || Anim = 3006) && AnimElem = 4
time = 2
palcolor = 0
paladd = 60,20,100
PalContrast = 220,200,350
Trans = none
TimeGap  = 1
FrameGap = 3
length = 11
ignorehitpause = 1

[State 3000, AfterImageTime]
type = AfterImageTime
triggerall = gametime%2 = 0
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElemTime(7) >= 0
trigger2 = (Anim = 3005 || Anim = 3006) && AnimElemTime(4) >= 0
time = 2

[State 3000, HitDef]
type = HitDef
triggerall = var(12) = 0
;triggerall = var(13) = 0 || var(13) >= 10
triggerall =!movecontact && !movereversed
trigger1 = (Anim = 3000 || Anim = 3001) && AnimElemTime(7) >= 0
trigger2 = (Anim = 3005 || Anim = 3006) && AnimElemTime(4) >= 0
attr = A, HA
damage    = 1
getpower  = 0
givepower = 0
animtype = Hard
air.animtype = back
guardflag = M
hitflag   = MAF
priority  = 4, Hit
pausetime = 3+(Helper(40000),var(0)),3
guard.pausetime = 3+(Helper(40000),var(0)),5
sparkno = s6005
guard.sparkno = s6012
sparkxy = -20, -76
hitsound = s1,1
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
guard.velocity = 0
air.type = High
air.hittime = 12
air.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
airguard.velocity = -4-ifelse(var(40),0.5,0),-1-ifelse(var(40),0.5,0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
yaccel = .5
fall = 1
fall.recover = 1
fall.recovertime = 600
fall.yvelocity = -3.5
kill = 0

[State 3000, ステート変更]
type = ChangeState
trigger1 = var(10) = 0
trigger1 = MoveContact || MoveReversed
value = 3010

[State 3000, ステート変更]
type = ChangeState
trigger1 = var(10) = 1
trigger1 = MoveHit && NumTarget
value = 3015

[State 3000, ステート変更]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
trigger2 = var(10) = 1
trigger2 = MoveContact || MoveReversed
value = 3001

[Statedef 3001]
type     = S
movetype = I
physics  = N
juggle   = 0
poweradd = 0
;velset   = 0,0
anim     = 3002
ctrl     = 0
sprpriority = 3

[State 3001, ChangeAnim]
