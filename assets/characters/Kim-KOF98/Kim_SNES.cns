trigger1 = RoundState = 2
trigger1 = NumHelper(8100) = 0
stateno = 8100
name = "win"
ID = 8100
pos = 0,-999
postype = p1
helpertype = normal
keyctrl = 0
ownpal = 1
pausemovetime = 99999999
supermovetime = 99999999

