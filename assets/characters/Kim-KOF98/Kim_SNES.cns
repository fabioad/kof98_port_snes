trigger4 = NumHelper(40000) = 1
trigger4 = RoundState >= 3 && Lose = 1 && Helper(40000),var(22) = 1
trigger5 = RoundState >= 3 && alive = 1 && winko
trigger5 = var(27) = 1
trigger6 = StateNo = 189
trigger7 = NumHelper(40000) = 1
trigger7 = Enemy,Name = "Gouki" && Enemy,AuthorName = "ikaruga" && Enemy,NumExplod(78413)
trigger7 = P2StateNo = 3507 && Helper(40000),var(22) = 1
var(37) = 1
ignorehitpause = 1

[State -2, KO演出ヘルパー]
