;---------------------------------------------------------------------------
; イントロ分岐
; CNS レベル: 基本
;
; ここでは変数(var)を使っていますが、詳しい説明は後ほど。
; VarRandomはrangeで指定された範囲からひとつを選ぶので、
; いろいろな分岐に便利です。

;イントロ選択
[Statedef 190]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 190, VarRandom]
type = VarRandom
trigger1 = 1
v = 0
range = 0,1

[State 190, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 190, 対悪人]
