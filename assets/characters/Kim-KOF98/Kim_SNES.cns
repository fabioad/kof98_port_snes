attr = C, NA
damage    = floor((ifelse(var(6),5,3)-var(21))*fvar(7)), 0
getpower  = floor(ifelse(var(40),0,3)*fvar(8)),floor(ifelse(var(40),0,3)*fvar(8))
givepower = floor(1*fvar(8)),floor(1*fvar(8))
animtype  = Light
air.animtype = back
guardflag = M
hitflag   = MAF
pausetime = 11+(Helper(40000),var(0)),13
guard.pausetime = 11+(Helper(40000),var(0)),11
sparkno = s6000+ifelse(var(40),3,0)
guard.sparkno = s6010
sparkxy = -12, -44
hitsound   = s1,0
guardsound = s2,0
ground.type = Low
ground.slidetime = 9
ground.hittime = 9
ground.velocity = -6-ifelse(var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -4.5-ifelse(var(40),0.5,0),-6.5-ifelse(var(40),0.5,0)
airguard.velocity = -4-ifelse(var(40),0.5,0),-1-ifelse(var(40),0.5,0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
yaccel = .5
fall.yvelocity = -3.5
ID = 10

[State 400, ヒット定義消去]
