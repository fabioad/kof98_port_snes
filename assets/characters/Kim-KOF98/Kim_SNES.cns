anim = 8400+Helper(9900),var(43)
postype = left
pos = 203,0
bindtime = -1
ownpal = 1
ontop = 1

[State 189, Explod];本体
type = Explod
trigger1 = time = 0
anim = 8240
postype = left
bindtime = -1
ownpal = 1
ontop = 1
[State 189, Explod];字幕
type = Explod
trigger1 = time = 0
anim = ifelse(var(5),8223+var(5),8220+random%4)
postype = left
bindtime = -1
ownpal = 1
