;---------------------------------------------------------------------------
; 勝利メッセージ
; CNS レベル: 基本

[Statedef 189]
type = S
ctrl = 0
anim = 9999
velset = 0,0

[State 189, PalFx]
type = PalFx
trigger1 = time = 0
add = 0,0,0
time = 1

[State 189, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = s15,5
AbsPan = 0

[State 189, RemoveExplod]
type = RemoveExplod
trigger1 = time = 0
ID = 78000

[State 189, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 189, Explod];背景
type = Explod
trigger1 = time = 0
anim = ifelse(teamside=1,8200,8201)
postype = left
bindtime = -1
removetime =-1
ownpal = 1
ontop = 1

[State 189, Explod];一人目移動
type = Explod
trigger1 = time=0&&NumHelper(9900)
trigger1 = Helper(9900),var(41)<=51&&Helper(9900),var(43)<=51
anim = 8300+Helper(9900),var(41)
postype = left
vel = 15,0
pos = -3000,0
ownpal = 1
ontop = 1
[State 189, Explod];一人目停止
type = Explod
trigger1 = time=0&&NumHelper(9900)
trigger1 = Helper(9900),var(41)<=51&&Helper(9900),var(43)<=51
anim = 8400+Helper(9900),var(41)
postype = left
bindtime = -1
ownpal = 1
ontop = 1

[State 189, Explod];二人目移動
type = Explod
trigger1 = time=0&&NumHelper(9900)
trigger1 = Helper(9900),var(43)<=51&&Helper(9900),var(43)<=51
anim = 8300+Helper(9900),var(43)
postype = left
vel = 15,0
pos = -2803,0
ownpal = 1
ontop = 1
[State 189, Explod];二人目停止
