trigger1 = Time = [0,220]
trigger2 = wintime
trigger2 = Time = [0,380]
flag = roundnotover

[State 181, Explod]
type = Explod
triggerall = teammode = single || teammode = turns
trigger1 = wintime = 0
trigger1 = Time = 200
trigger2 = wintime
trigger2 = Time = 360
anim = 8000
ID = 78000
ontop = 1
postype = left
scale = 500.0,10.0
ownpal = 1
bindtime = -1
ignorehitpause = 1

[State 181, 特殊効果]
type = AssertSpecial
trigger1 = numexplod(78000) = 1
flag = nobardisplay

[State 181, ChangeState]
type = ChangeState
triggerall = matchover
trigger1 = wintime = 0 && Time = 216
trigger2 = wintime && Time = 376
value = 189

