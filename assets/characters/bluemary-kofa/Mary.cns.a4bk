; INTRO
[Statedef 191]
type = S
physics = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] ;If opponent is Terry, go to alternate intro
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "Terry Bogard"
trigger2 = P4Name = "Terry Bogard"
value = 193

[State 191, 2] ;Random alternate intro (jump in)
type = ChangeState
triggerall = Time = 1
trigger1 = Random < 333
trigger1 = command != "hold_a" && command != "hold_c"
trigger2 = command = "hold_b" || command = "hold_z"
value = 196

[State 191, 2] ;Random alternate intro (stretch)
type = VarSet
triggerall = Time = 1
trigger1 = Random < 500
trigger1 = command != "hold_a"
trigger2 = command = "hold_c"
var(1) = 1

[State 191, 3]
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 4] ;Intro not yet over
type = AssertSpecial
trigger1 = AnimElemTime(13) < 0
flag = Intro

[State 191, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 191, 6]
type = PlaySnd
trigger1 = AnimElemTime(3) = 3
trigger1 = P3Name != "Terry Bogard"
trigger1 = !var(1)
value = 8,0 ;"Here we go!"
channel = 0 ; Voice channel

[State 191, 7]
type = PlaySnd
trigger1 = AnimElemTime(3) = 3
trigger1 = var(1)
value = 10,2 ;"Anton!"
channel = 0 ; Voice channel

[State 191, 8]
type = PlaySnd
trigger1 = AnimElemTime(5) = 0
trigger1 = P3Name = "Terry Bogard"
trigger1 = !var(1)
value = 8,3 ;"Let's fight"
channel = 0

[State 191, 9]
type = PlaySnd
trigger1 = AnimElemTime(6) = 3
value = 8,4 ;"Woof!"
pan = -40

[State 191, 10] ;Mary's important jacket
type = Explod
trigger1 = AnimElem = 2
anim = 191
pos = 0,0
postype = p1
bindtime = -1
sprpriority = 1

[State 191, 11] ;Dog
type = Explod
trigger1 = AnimElem = 7, -4
anim = 192
pos = -95,0 ;-75,0
postype = p1
vel = 5
sprpriority = -2
shadow = -1
ownpal = 1

[State 191, 12] ;Jacket thrown
type = Explod
trigger1 = AnimElem = 7
anim = 193
pos = 0,-5
postype = p1
vel = 2, -3
accel = 0, .25
sprpriority = 1
shadow = -1

[State 191, 13] ;Jacket caught by dog
type = Explod
trigger1 = AnimElemTime(9) = 7
anim = 194
pos = 60,0
postype = p1
vel = 5
sprpriority = -1
shadow = -1

[State 191, 14] ;Stretch intro
type = ChangeState
trigger1 = AnimElem = 8
trigger1 = var(1)
value = 198

