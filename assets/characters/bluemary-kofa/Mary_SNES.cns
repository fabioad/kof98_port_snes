; 0: Stand 
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0

[State Set]
type = Changeanim
triggerall = var(0) = 1
triggerall = anim != 1
triggerall = anim != 5
trigger1 = stateno = 0
value = 1

[State 0, 1]
type = ChangeAnim
triggerall = var(0) != 1
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = Var(0) = 1
trigger1 = Anim != 5 && Anim != 1
trigger2 = Anim = 5 && AnimTime = 0 
value = 1

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 4]
type = ChangeState
trigger1 = !alive
value = 5050

