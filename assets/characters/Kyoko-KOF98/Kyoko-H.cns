trigger1 = AnimElem = 10 || AnimElem = 11 || AnimElem = 12 || AnimElem = 14 || AnimElem = 15
trigger2 = AnimElem = 16 || AnimElem = 30 || AnimElem = 31
x = 16

[State 3000, 音を鳴らす]
