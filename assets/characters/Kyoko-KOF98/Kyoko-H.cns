trigger1 = AnimElemtime(42) > 0
x = .94

[State 3000, 軸位置移動]
type = VelAdd
trigger1 = AnimElemtime(42) > 0
y = .4

[State 3000, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 42
statetype = A

[State 3000, Movehitreset]
type = MoveHitReset
trigger1 = AnimElem = 23 || AnimElem = 29 || AnimElem = 35 || AnimElem = 42

[State 3000, ヒット定義]
type = HitDef
triggerall = var(12) = 0
triggerall = var(13) = 0 || var(13) >= 10
triggerall =!movecontact && !movereversed
trigger1 = AnimElemTime(13) >= 0 && AnimElemTime(14) < 0
