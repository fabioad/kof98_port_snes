trigger1 = AnimElem = 12 || AnimElem = 22 || AnimElem = 28 || AnimElem = 34
value = s0,2

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 42
value = s3,0

[State 3000, 軸位置移動]
type = VelSet
trigger1 = AnimElem = 42
x = 4
y = -6

[State 3000, 軸位置移動]
