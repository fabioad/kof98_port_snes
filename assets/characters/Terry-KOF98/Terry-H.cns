;(HELPER)パワーゲイザー・ヘルパー
[Statedef 3020]
type     = A
movetype = A
physics  = N
ctrl     = 0
anim     = 3020 + (Root,var(10) = 1 && Helper(40000),var(3) = 1)
sprpriority = 5

[State 3000, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 3000, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoShadow ;影を消す

[State 1000, AirGuard]
type = AssertSpecial
trigger1 = p2statetype = A
trigger1 = enemy,Vel X > 0
flag = unguardable

[State 3000, AttackDist]
type = AttackDist
trigger1 = 1
value = 160

[State 3020, DM/SDM Flash]
type = EnvColor
trigger1 = movehit = 1
time = 1
value = 255,255,255
under = 1

[State 3020, ヒット定義]
type = HitDef
triggerall = Root,var(12) = 0
triggerall = Root,var(13) = 0 || Root,var(13) >= 10 || Root,Var(10) = 2
triggerall =!movecontact && !movereversed
trigger1 = Anim = 3020 && AnimElemTime(3) >= 0 && AnimElemTime(11) < 0
trigger2 = Anim = 3021 && AnimElemTime(3) >= 0 && AnimElemTime(8) < 0
attr = A, HP
damage    = floor(((ifelse(root,var(6),48,37)-root,var(21))*root,fvar(7))*root,fvar(0)),floor(1*root,fvar(7))
getpower  = 0
givepower = floor(1*root,fvar(8)),floor(1*root,fvar(8))
animtype  = Up
guardflag = M
hitflag = MAFP
priority  = 4, Hit
pausetime = 0,13
guard.pausetime = 0,11
sparkno = s6005
guard.sparkno = s6012
sparkxy = -28,-41 + (floor(p2bodydist Y))
hitsound = s1,ifelse(root,var(10) = 1,9,4)
guardsound = s2,1
ground.type = High
ground.slidetime = 17
ground.hittime = 17
ground.velocity = -2-ifelse(Root,var(40),0.5,0),-12.5-ifelse(Root,var(40),0.5,0)
guard.velocity = -10.5-ifelse(Root,var(40),0.5,0)
air.type = High
air.hittime = 12
air.velocity = -2-ifelse(Root,var(40),0.5,0),-12.5-ifelse(Root,var(40),0.5,0)
airguard.velocity = -4-ifelse(Root,var(40),0.5,0),-1-ifelse(Root,var(40),0.5,0)
fall.yvelocity = -3.5
yaccel = .55
fall = 1
fall.recover = 1
fall.recovertime = 600
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
envshake.time = 15
envshake.ampl = 3
envshake.freq = 90

[State 3020, ヒット定義消去]
type = HitDef
triggerall = Root,var(12) > 0
trigger1 = Anim = 3020 && AnimElemTime(3) >= 0 && AnimElemTime(11) < 0
trigger2 = Anim = 3021 && AnimElemTime(3) >= 0 && AnimElemTime(8) < 0
attr = 

[State 3020, MoveType]
type = StateTypeSet
trigger1 = Anim = 3020 && AnimElem = 11
trigger2 = Anim = 3021 && AnimElem = 8
MoveType = I

[State 3020, ジャグル設定]
type = ParentVarSet
trigger1 = movehit = 1
var(13) = ifelse(Root,var(6) >= 1,14 + (Root,var(40) > 0),1)
[State 3020, ジャグル設定]
type = ParentVarSet
trigger1 = movehit = 1
var(14) = 0

[State 3020, 投げ制限1]
type = ParentVarSet
trigger1 = movecontact = 1
var(17) = 6
[State 3020, 投げ制限2]
type = ParentVarSet
trigger1 = movecontact = 1
var(18) = 2

[State 3020, スロー処理]
