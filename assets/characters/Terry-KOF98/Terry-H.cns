triggerall = RoundState = 2
triggerall = p2movetype = H
trigger1 = moveguarded = 1
fvar(10) = floor((38-root,var(21))*root,fvar(12))
ignorehitpause = 1
persistent = 0

[State 3020, ガードクラッシュ値回復不能時間]
