name = "down_a"
command = /$D,a
time = 1

[Command]
name = "down_b"
command = /$D,b
time = 1

;---------------------------------------------------------------------------
; 2. State entry
; --------------------------------------------------------------------------
[Statedef -1]

;//==========================
;// add004-1-sctrls-start
;//==========================
;--- partner_standby
[state 0]
	type=selfstate
	trigger1=ctrl && numpartner && !ishelper && roundstate=2 && pos y=0
	trigger1=sysfvar(4)>0 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(22)=4
	value=190190
	ctrl=0
	ignorehitpause=1
;//==========================
;// add004-1-sctrls-end
;//==========================




; AI Helper Check
[State -1, AI Helper Check]
type = ChangeState
trigger1 = IsHelper(9741)
value = 9741

; AI Helper Check 2
[State -1, AI Helper Check 2]
type = ChangeState
trigger1 = IsHelper(9742)
value = 9742

;===========================================================================
; Ai Section
;===========================================================================
; Jump
[State -1, AI Jump]
type = ChangeState
triggerAll = var(0)
triggerAll = random < 200
triggerAll = statetype != A
triggerAll = ctrl
triggerAll = p2bodydist x >= 70
trigger1 = EnemyNear, AnimTime < -30
trigger1 = p2MoveType = A
trigger1 = p2statetype != A
trigger1 = p2stateNo = [1000,2999]
value = 40

; Jump Attacks
[State -1, AI Jump Attacks 1]
type = ChangeState
triggerAll = var(0)
triggerAll = statetype = A
triggerAll = ctrl
triggerAll = p2bodydist x <= 50
triggerall = random < 600
trigger1 = vel y > 0 && pos y = [-46,-35]
trigger1 = p2statetype != A
trigger1 = vel x != 0
value = ifelse(random < 300, 610, ifelse(random < 300, 640, ifelse(random < 500, 600, 630)))

; Jump Attacks
[State -1, AI Jump Attacks 2]
type = ChangeState
triggerAll = var(0)
triggerAll = statetype = A
triggerAll = ctrl
triggerAll = p2bodydist x <= 50
triggerall = random < 600
trigger1 = vel y > 0 && pos y = [-46,-35]
trigger1 = p2statetype != A
trigger1 = vel x = 0
value = ifelse(random < 400, 645, ifelse(random < 500, 605, 635))

; Roll Forwards
[State -1, AI Roll Forwards]
type = ChangeState
triggerAll = var(0)
triggerAll = random < 80
triggerAll = statetype != A
triggerAll = inguarddist
trigger1 = p2bodydist x = [25,105]
trigger1 = EnemyNear, AnimTime = [-53,-37]
trigger1 = p2statetype != A
trigger1 = ctrl || (stateno = [100,101]) || stateno = [120,131]
trigger2 = stateno = 100
trigger2 = p2bodydist x > 130
value = 900

; Stand Guard
[State -1, AI Standing Guard]
type = changestate
triggerall = NumEnemy
triggerall = RoundState = 2 && var(0)
triggerall = StateType != A
triggerall = P2StateType != C
triggerall = StateType = S
triggerall = (P2Movetype = A) || (Enemy, NumProj >= 1)
trigger1 = Ctrl && P2BodyDist X <= 90
trigger1 = random <= 800
value = 130

; Stand to Crouch Guard
[State -1, AI Stand to Crouch Guard]
type = ChangeState
triggerall = NumEnemy
triggerall = RoundState = 2 && var(0)
triggerall = StateType != A
triggerall = P2StateType = C
triggerall = (P2Movetype = A) || (Enemy, NumProj >= 1)
trigger1 = StateNo = 150
trigger1 = 1
value = 152

; Crouch Guard
[State -1, AI Crouch Guard]
type = ChangeState
triggerall = NumEnemy
triggerall = RoundState = 2 && var(0)
triggerall = StateType != A
triggerall = P2StateType = C
triggerall = (P2Movetype = A) || (Enemy, NumProj >= 1)
trigger1 = Ctrl
trigger1 = random <= 800
value = 131

; Crouch to Stand Guard
[State -1, AI Crouch to Stand Guard]
type = ChangeState
triggerall = NumEnemy
triggerall = RoundState = 2 && var(0)
triggerall = StateType != A
triggerall = P2StateType != C
triggerall = (P2Movetype = A) || (Enemy, NumProj >= 1)
trigger1 = StateNo = 152
trigger1 = 1
value = 150

; Jump Guard
[State -1, AI Jump Guard]
type = changestate
triggerall = NumEnemy
triggerall = RoundState = 2 && var(0)
triggerall = StateType = A
triggerall = (P2Movetype = A) || (Enemy, NumProj >= 1)
trigger1 = ctrl
trigger1 = random <= 800
value = 132

; Koshuu Tou Throw
[State -1, AI Koshuu Tou Wow]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
triggerall = ctrl && StateType != A
triggerall = P2statetype != A && P2statetype != L
triggerall = P2movetype = I && P2movetype != H
triggerall = P2bodyDist X <= 10
triggerall = P2stateno != 5120
trigger1 = Random < 150
value = ifelse(random <= 500, 800, 825)

; Ryuusei Raku  Throw
[State -1, AI Ryuusei Raku ]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
triggerall = ctrl && StateType = A
triggerall = P2statetype = A
triggerall = P2movetype != H
triggerall = p2bodydist X <= 10 && P2bodyDist Y = [-65,15]
trigger1 = Random < 200
value = 850

; Emergency Evade
[State -1, AI Emergency Evade]
type = ChangeState
triggerall = roundstate = 2 && var(0)
Triggerall = (ctrl || (stateno = 52 && animelemtime(1) > 0) || (stateno = [100, 101])) && statetype != A
triggerall = enemynear, hitdefattr = SCA,NA,SA,HA,NP,SP,HP
triggerall = p2bodydist x <= 70
triggerall = P2statetype != A
triggerall = P2MoveType = A
trigger1 = Random < 100
value = ifelse(random < 500, 900, 905)

; Guard Cancel Blowback Attack
[State -1, AI Guard Cancel Blowback Attack]
type = ChangeState
triggerall = NumEnemy
triggerall = RoundState = 2 && var(0)
triggerall = Power >= 1000 && StateType != A
triggerall = P2BodyDist x <= 30
trigger1 = (stateno = 150 || stateno = 152)
trigger1 = random < 50
value = 915

;Kikouken
[State -1, AI Kikouken]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
triggerall = numproj = 0
triggerall = ctrl && StateType != A
triggerall = P2statetype != A
triggerall = p2movetype != A
trigger1 = prevstateno != 5120 || prevstateno != 1000
trigger1 = (P2bodydist X = [80,235]) && p2stateno != 5120 && random < 50
trigger2 = (P2bodydist X = [45,100]) && p2stateno = 5120 && random < 100
value = 1000

;Kikouken (short version)
[State -1, AI Kikouken (short version)]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
triggerall = numproj = 0
triggerall = ctrl && StateType != A
triggerall = P2statetype != A && p2movetype != H
triggerall = p2movetype != A
trigger1 = prevstateno != 5120 || prevstateno != 1000
trigger1 = (P2bodydist X = [15,80]) && p2stateno != 5120 && random < 150
value = 1050

;Hyakuretsu Kyaku
[State -1, AI Hyakuretsu Kyaku]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
triggerall = numproj = 0
triggerall = ctrl && StateType != A
triggerall = P2statetype != A && p2movetype != H
triggerall = p2movetype != A
trigger1 = prevstateno != 5120 || prevstateno != 1000
trigger1 = (P2bodydist X = [25,75]) && p2stateno != 5120 && random < 50
