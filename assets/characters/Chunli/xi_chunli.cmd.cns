; Combo H
[State -1, AI Combo H]
type = ChangeState
triggerall = NumEnemy
Triggerall = roundstate = 2 && Var(0)
triggerall = p2statetype != A
triggerall = p2bodydist x <= 75
trigger1 = movecontact && stateno = 215 && (animelemtime(3) >= 0 && animelemtime(4) <= 0) && random < 800
trigger2 = movecontact && stateno = 245 && (animelemtime(4) >= 0 && animelemtime(5) <= 0) && random < 800
trigger3 = movecontact && stateno = 410 && (animelemtime(4) >= 0 && animelemtime(6) <= 0) && random < 800
trigger4 = movecontact && stateno = 700 && (animelemtime(7) >= 0 && animelemtime(8) <= 0) && (prevstateno = [200,499]) && random < 800
trigger5 = movecontact && stateno = 705 && (animelemtime(7) >= 0 && animelemtime(8) <= 0) && (prevstateno = [200,499]) && random < 800
trigger6 = movecontact && stateno = 710 && (animelemtime(8) >= 0 && animelemtime(9) <= 0) && (prevstateno = [200,499]) && random < 800
value = ifelse(movehit && p2bodydist x <= 30 && random < 200, 1400, ifelse(p2bodydist x <= 70 && random < 300, 1050, ifelse(P2bodydist x <= 70 && random < 500, 1100, ifelse(p2statetype != C && random < 500, 1200, 1000))))

; Combo I
