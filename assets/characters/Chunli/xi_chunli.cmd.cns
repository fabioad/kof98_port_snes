trigger6 = movecontact && stateno = 215 && (animelemtime(3) >= 0 && animelemtime(4) <= 0)
trigger7 = movecontact && stateno = 235 && (animelemtime(2) >= 0 && animelemtime(4) <= 0)
trigger8 = movecontact && stateno = 245 && (animelemtime(4) >= 0 && animelemtime(5) <= 0)
trigger9 = movecontact && stateno = 400 && (animelemtime(2) >= 0 && animelemtime(3) <= 0)
trigger10 = movecontact && stateno = 410 && (animelemtime(4) >= 0 && animelemtime(6) <= 0)
trigger11 = movecontact && stateno = 430 && (animelemtime(3) >= 0 && animelemtime(4) <= 0)
