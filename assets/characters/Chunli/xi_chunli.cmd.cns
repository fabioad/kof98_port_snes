trigger6 = movehit && stateno = 710 && (animelemtime(8) >= 0 && animelemtime(9) <= 0) && (prevstateno = [200,499]) && random < 100
trigger7 = stateno = 1050 && (projhit(1050) = 1, < 15) && (animelemtime(10) >= 0 && animelemtime(12) < 0) && random < 800
