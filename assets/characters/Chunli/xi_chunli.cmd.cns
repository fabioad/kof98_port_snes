;Spinning Bird Kick
[State -1, AI Spinning Bird Kick]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
triggerall = numproj = 0
triggerall = ctrl && StateType != A
triggerall = P2statetype != A && p2movetype != H
triggerall = p2movetype != A
trigger1 = prevstateno != 5120 || prevstateno != 1000
trigger1 = (P2bodydist X = [90,145]) && p2stateno != 5120 && random < 30
value = 1200

; Tenshou Kyaku
[State -1, AI Tenshou Kyaku]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
triggerall = (ctrl || (stateno = 130) || (stateno = [100, 101])) && StateType != A && p2movetype != H
triggerall = FrontEdgeDist >= 40
trigger1 = P2statetype = A && enemynear, vel x > 0 && enemynear, vel Y > 0 && (p2dist x = [15,55]) && (EnemyNear, Pos Y = [-80,-25]) && random < 500
trigger2 = P2statetype = A && enemynear, vel x = 0 && enemynear, vel Y > 0 && (p2dist x = [20,55]) && (EnemyNear, Pos Y = [-80,-25]) && random < 500
trigger3 = p2statetype != A && p2movetype = A && p2bodydist x <= 40 && random < 650
value = 1400

; Tenshou Kyaku
[State -1, AI Tenshou Kyaku]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
trigger1 = numtarget(3100) = 1 && stateno = 3105 && animtime = 0 && random < 900
value = ifelse(random < 500, 1400, 210)

; Tenshin Enbu
[State -1, AI Tenshin Enbu]
type = ChangeState
triggerall = NumEnemy
triggerall = roundstate = 2 && var(0)
Triggerall = (ctrl || (stateno = [100, 101])) && statetype != A
triggerall = p2statetype != A && P2statetype != L && p2movetype != H
triggerall = P2bodyDist X <= 25
triggerall = P2stateno != 5120
trigger1 = Random < 400
value = 1500

; Combo Starter 1 (Light Attacks)
[State -1, AI Combo Starter 1]
type = changestate
triggerall = NumEnemy
Triggerall = roundstate = 2 && Var(0)
Triggerall = (ctrl || (stateno = 52 && animelemtime(1) > 0) || (stateno = [100, 101])) && statetype != A
triggerall = p2statetype != L && p2statetype != A
trigger1 = p2bodydist X <= 35
trigger1 = random < 500
value = ifelse((random < 250 && p2bodydist x <= 25),205,ifelse(random < 500,400,430))

; Combo Starter 2 (Strong Attacks)
[State -1, AI Combo Starter 2]
type = changestate
triggerall = NumEnemy
Triggerall = roundstate = 2 && Var(0)
Triggerall = (ctrl || (stateno = 52 && animelemtime(1) > 0) || (stateno = [100, 101])) && statetype != A
