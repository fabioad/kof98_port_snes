trigger2 = movecontact && stateno = 245 && (animelemtime(4) >= 0 && animelemtime(5) <= 0) && random < 700
trigger3 = movecontact && stateno = 410 && (animelemtime(4) >= 0 && animelemtime(6) <= 0) && random < 700
