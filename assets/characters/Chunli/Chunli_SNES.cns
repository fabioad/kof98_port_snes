; The King of Fighters XI - Chun Li CNS

;----------------------------------------------------------
;       ﾍndice de Vari疱eis
;----------------------------------------------------------
; var(0)  = the simplifier variable, optional but helpful.
; var(1)  = winstate decider
; var(2)  = Attack strenght
; var(3)  = Hyakuretsu Kyaku Controller
; var(4)  =
; var(5)  = Long Jump
; var(6)  = Long Jump Sound Controller
; var(7)  =
; var(8)  =
; var(9)  =

; var(56) = used by the XOR-ed commands method to detect recent custom states.
; var(57) = the GameTime variable, required by the helper and XOR methods.
; var(58) = the primary AI variable.
; var(59) =

; fvar(3) = Aerial throw velocity controller

 
[Data]
life = 1500
attack = 120
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 160
IntPersistIndex = 55
FloatPersistIndex = 40
power = 3000

[Size]
xscale = 1           
yscale = 1           
ground.back = 15
ground.front = 15
air.back = 15
air.front = 15
height = 65
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = -14, -83
mid.pos = -21, -59
shadowoffset = 0    
draw.offset = 0,0    

[Velocity]
walk.fwd  = 3.3125
walk.back = -3.3125
run.fwd  = 6.078125, 0
run.back = -6.078125,-5.36523438
jump.neu = 0,-11
jump.back = -3.3125
jump.fwd = 3.3125
runjump.back = -4.54921875
runjump.fwd = 4.54921875
airjump.neu = 0,-9.066406
airjump.back = -3.3125
airjump.fwd = 3.3125
;low jump = -6.6015625

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .64453
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10
velset = 0,0

[State 10, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0
velset = 0,0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12
velset = 0,0

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && Time > 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && Time > 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
velset = 0,0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VarSet
trigger1 = command = "longjump"
trigger1 = !time
trigger2 = var(0)
trigger2 = P2Bodydist x > 65
var(5) = 1

[State 40, 5]
type = VarSet
triggerall = prevstateno = 100
trigger1 = !time
var(6) = 1

[State 40, 6]
type = VelSet
triggerall = !var(5)
triggerall = !var(0)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(command = "holdup", const(velocity.jump.y),(const(velocity.jump.y)*.7428))

[State 40, 7]
type = VelSet
triggerall = var(5)
triggerall = !var(0)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = ifelse(command = "holdup", const(velocity.jump.y),(const(velocity.jump.y)*.7428))

[State 40, 8]
type = VelSet
triggerall = !var(0)
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = ifelse(command = "holdup", const(velocity.jump.y),(const(velocity.jump.y)*.7428))

[State 40, 9]
type = VelSet
triggerall = !var(5)
triggerall = var(0)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(p2bodydist x > 100, const(velocity.jump.y),(const(velocity.jump.y)*.7428))

[State 40, 10]
type = VelSet
triggerall = var(5)
triggerall = var(0)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = ifelse(p2bodydist x > 100, const(velocity.jump.y),(const(velocity.jump.y)*.7428))

[State 40, 11]
type = VelSet
triggerall = var(0)
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = ifelse(P2Bodydist x > 100, const(velocity.jump.y),(const(velocity.jump.y)*.7428))

[State 40, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Triangle Jump
[Statedef 45]
type    = A
physics = N
anim = 48
ctrl = 0

[State 45, 1]
type = VarSet
trigger1 = !time
sysvar(1) = 0

[State 45, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 4]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 45, 5]
type = Turn
triggerall = sysvar(1) = -1
trigger1 = !time

[State 45, 6]
type = VelSet
trigger1 = !Animtime
x = ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x))
y = const(velocity.jump.y)

[State 45, 7]
type = AfterImageTime
trigger1 = !time
time = 0

[State 45, 8]
type = ChangeState
trigger1 = !Animtime
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 0]
type = PlaySnd
triggerall = var(6)
trigger1 = time = 0
value = s50,ifelse(vel y = const(velocity.jump.y),2,1)

[State 50, 1]
type = PlaySnd
triggerall = !var(5)
trigger1 = time = 0
value = s50,ifelse(vel y = const(velocity.jump.y),1,0)

[State 50, 2]
type = PlaySnd
triggerall = var(5)
trigger1 = time = 0
value = s50,ifelse(vel y = const(velocity.jump.y),2,1)

[State 50, 3]
type = VarSet
trigger1 = Time = 0
var(5) = 0

[State 50, 3]
type = VarSet
trigger1 = Time = 0
var(6) = 0

[State 50, 4]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 5]
type = ChangeAnim
triggerall = vel y > (const(velocity.jump.y))
trigger1 = Time = 0
value = ifelse((vel x)=0, 1041, ifelse((vel x)>0, 1042, 1043))

[State 50, 6]
type = ChangeAnim
triggerall = vel y <= const(velocity.jump.y)
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 7]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 8]
type = AfterImage
triggerall = vel x = const(velocity.runjump.fwd.x) || vel x = const(velocity.runjump.back.x)
trigger1 = time = 0
time = 20
length = 15
palbright = 40,40,40
palcontrast = 250,250,250
palpostbright = -80,-80,-80
timegap = 1
flamegap = 1
trans = add1

[State 50, 10]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52

