;=====================================================================
; Definition of the Special Arts
;=====================================================================

;-------------------------------------------------------------------------------
; タイガーアッパーカット
;------------------------ 弱
[Statedef 1000]
type = S
movetype = A
physics = S
anim = 1000
velset = 0,0
ctrl = 0
poweradd= 96
juggle  = 8+(P2StateType = A)*8

[State -2,2]
type = VarSet
trigger1 = Time = 0 && var(11) = -1
var(11) = 1

[State 3300, 1]
type = NotHitBy
trigger1 = var(11) = 1 && AnimElemNo(0) < 7
value = SCA

[State -2,VarSet]
type = VarSet
triggerall = Time = 0
trigger1 = var(40) = 4
var(41) = 8

[State 1030, Varadd(24)]
type = Varadd
triggerall = var(40) = 4 && var(41) = 8
trigger1 = Time = 0 && fvar(0) > 4.8
fvar(0) = -4.8

[State 1030, VarSet(24)]
type = VarSet
triggerall = var(40) = 4 && var(41) = 8
trigger1 = Time = 0 && fvar(0) <= 4.8
fvar(0) = 0.1

[State -3,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1,=0
value = 5, 0

[State -3,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1,=1
value = 0, 10
channel = 0

[State 1000, 2]
type = StateTypeSet
trigger1 = AnimElem = 6
statetype = A
physics = N

[State 1000, 2]
type = VelSet
trigger1 = AnimElem = 6
x = 5
y = -5

[State 1000, 2]
type = VelAdd
trigger1 = AnimElemNo(0) = 6
x = -.2
y = .4

[State 1000, 2]
type = VelSet
trigger1 = AnimElem = 7
x = 0
y = 0

[State 1000, 2]
type = VelAdd
trigger1 = AnimElem = 12,> 0
y = .36

[State 245,HitDef]
type = HitDef
trigger1 = !MoveContact
trigger1 = AnimElem = 5
attr = S, SA
animtype = Back
damage    = IfElse(Var(16)=1,117,99)+(var(11))*9,12
getpower = 64,64
guardflag = M
hitflag = MAF
pausetime = 10,13
guard.pausetime = 11,11
sparkno = 2
guard.sparkno = 42
sparkxy = 0,-45
hitsound = S3, 4
guardsound = S4, 1
ground.type = High
ground.slidetime = 18
ground.hittime  = 18
ground.velocity = -4,-7
guard.velocity = -11
air.hittime = 13
air.velocity = -4,-7
air.cornerpush.veloff = 0
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = -11
yaccel = .5
air.juggle = 8
fall = 1

[State 245,HitDef]
type = HitDef
trigger1 = !MoveContact
trigger1 = AnimElem = 6
attr = A, SA
animtype = Back
damage    = IfElse(Var(16)=1,117,99)+(var(11))*9,12
getpower = 64,64
guardflag = M
hitflag = MAF
pausetime = 10,13
guard.pausetime = 11,11
sparkno = 2
guard.sparkno = 42
sparkxy = 0,-70+floor(P2Dist Y)
hitsound = S3, 4
guardsound = S4, 1
ground.type = High
ground.slidetime = 18
ground.hittime  = 18
ground.velocity = -4,-7
guard.velocity = -11
air.hittime = 13
air.velocity = -4,-7
air.cornerpush.veloff = 0
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
yaccel = .5
air.juggle = 8
fall = 1

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 7
movetype = I

[State 1000, 2]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 1001

