trigger1 = Root,ProjGuardedTime(0)=1
anim = f42
id = 2020
sprpriority = 10
pos = -10,-floor(P2Dist Y)
postype = p2
ignorehitpause = 1
ownpal = 1

[State 6020, 4]
type = ChangeState
trigger1 = Time > 0
trigger1 = Root,NumProjid(6000)=0
value = 6021+(var(1)<=1)

[State 6020, 4]
type = ChangeState
trigger1 = FrontEdgeDist < -50
value = 6025

