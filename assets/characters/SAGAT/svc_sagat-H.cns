[Statedef 6020]
type = A
movetype = A
physics = N
ctrl = 0
velset = 0,0
ownpal = 1
sprpriority = 2

[State 190, 1]
type = ChangeAnim
trigger1 = Time = 0 && PrevStateNo != 6021
value = IfElse((IsHelper(6050)),3407,6025)

[State 4110, Varset]
type = Velset
trigger1= 1
x = IfElse((IsHelper(6050)),15,IfElse((IsHelper(6010)),7,4))

[State 4110, Varset]
type = Varset
trigger1= Time = 0 && PrevStateNo != 6021
var(1) = IfElse((IsHelper(6010)),5,3)

[State 3000,Projectile]
type = Projectile
trigger1 = Time = 0
trigger2 = root,NumProjid(6000)!=0
projremovetime = 1
projanim = 6026
ProjHitAnim = -1
projid = 6000
offset = 0,0
velocity = 0,0
projshadow = -1,-1,-1
attr = S, SP
animtype = Hard
air.animtype = Back
damage    = Ceil((IfElse((Root,Var(16)),153,140)-(IsHelper(6010))*4.5)/(2**(Root,var(13)))),8
getpower = 0,0
guardflag = M
pausetime = 1,3
guard.pausetime = 1,10
sparkno = -1
guard.sparkno = -1
projedgebound = 50
sparkxy = 0,0
hitsound = S3, 3
guardsound = S4, 1
ground.type = High
ground.slidetime = 18
ground.hittime  = 18
ground.velocity = -.5
air.velocity = -3,-7
air.cornerpush.veloff = 0
yaccel = .55
;air.juggle = 8
air.fall = 1
fall.recover = 0

[STate 3000]
type = Explod
trigger1 = Root,ProjhitTime(0)=1
anim = f2
id = 2020
sprpriority = 10
pos = -10,-floor(P2Dist Y)
postype = p2
ignorehitpause = 1
ownpal = 1

[STate 3000]
