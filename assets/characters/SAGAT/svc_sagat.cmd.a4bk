; Special Attacks , Moves and so on.
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 地上ふっとばし攻撃
[State -1]
type = ChangeState
value = 500
triggerall = Command = "by"
trigger1 = StateType != A && (Ctrl || var(40)=1)
trigger2 = movecontact && stateno = 300

;---------------------------------------------------------------------
; ガードキャンセル吹っ飛ばし攻撃
