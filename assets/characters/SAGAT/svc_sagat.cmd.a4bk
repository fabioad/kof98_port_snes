triggerall = StateType = S && Ctrl
trigger1 = P2MoveType != H && !P2StateType = A
trigger1 = (Command = "fwd_y" && P2BodyDist X < 8) || (Command = "back_y" && P2BodyDist X < 20)

;---------------------------------------------------------------------------
