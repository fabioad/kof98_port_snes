;===========================================================
; Constants and state file for Sagat(SVC CHAOS Ver)
;===========================================================

;---------------------------------------------------------------------
; 曄悢昞
;僉儍儔僋僞乕梡 var(10-29)
;	var(10) : 
;	var(11) : 傾儞僌儕乕僠儍乕僕
;	var(12) : 僗儘乕儌乕僔儑儞梡
;	var(13) : 挻昁僸僢僩悢
;	var(14) : 僸僢僩悢僇僂儞僩1
;	var(15) : 僸僢僩悢僇僂儞僩2
;僨僼僅儖僩僔僗僥儉梡 fvar(1-39)
;	fvar(0) : 摿庩儌乕僪帪娫寁應
;	fvar(1) : X幉埵抲寁應
;	fvar(2) : Y幉埵抲寁應
;	fvar(3) : 儃僞儞擖椡僼儔僌
;	fvar(4) : 僉儍儔敾暿僼儔僌
;	var(58) : 僗僐傾曐懚梡曄悢
;	var(59) : 僗僩儔僀僇乕丒媄偺僗僥乕僩斣崋傪曐懚
;
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 婎杮愝掕
[Data]
life = 1500
power = 5000
attack = 105         ; 峌寕椡乮亾乯
defence = 105        ; 杊屼椡乮亾乯
fall.defence_up   = 30
liedown.time      = 50
airjuggle = 15        ; 嬻拞僐儞儃
sparkno = 1        ; 弶婜僸僢僩僗僷乕僋斣崋
guard.sparkno = 41 ; 弶婜僈乕僪僗僷乕僋斣崋
KO.echo = 0          ; 俲俷儃僀僗僄僐乕乮0:OFF丄1:ON乯
volume = 128          ; 僉儍儔儃僀僗儃儕儏乕儉抣
IntPersistIndex=30,46,58,59

[Size]
xscale = 1           ; 悈暯僒僀僘攞棪
yscale = 1           ; 悅捈僒僀僘攞棪
ground.back = 16     ; 僉儍儔暆乮抧忋丄屻傠懁乯
ground.front = 15    ; 僉儍儔暆乮抧忋丄慜懁乯
air.back = 12        ; 僉儍儔暆乮嬻拞丄屻傠懁乯
air.front = 12       ; 僉儍儔暆乮嬻拞丄慜懁乯
z.width = 60         ; 僉儍儔暆乮倸幉乯
height = 60	     ; 僉儍儔偺崅偝乮僕儍儞僾偱旘傃墇偣傞崅偝乯
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5,-95    ; 摢晹嵗昗
mid.pos = -5,-60     ; 懱拞怱晹嵗昗
shadowoffset = 0     ; 僉儍儔偺塭丒僆僼僙僢僩抣

[Velocity]
walk.fwd  = 3.06		; 慜恑懍搙
walk.back = -3.08		; 屻戅懍搙
run.fwd  = 9,0		; 慜僟僢僔儏懍搙乮y<0偺応崌丄儂僢僾僗僥僢僾乯
run.back = -9,-4		; 僶僢僋僗僥僢僾懍搙乮y=0偺応崌丄憱傝乯
jump.neu = 0,-11		; 悅捈僕儍儞僾懍搙
jump.back = -3.24		; 屻曽僕儍儞僾懍搙
jump.fwd = 3.27		; 慜曽僕儍儞僾懍搙
runjump.back = -4.88,-11	; 屻曽僕儍儞僾懍搙乮僟僢僔儏拞乯
runjump.fwd = 4.91,-11	; 慜曽僕儍儞僾懍搙乮僟僢僔儏拞乯
airjump.neu = 0,0		; 嬻拞悅捈僕儍儞僾懍搙
airjump.back = 0		; 嬻拞屻曽僕儍儞僾懍搙
airjump.fwd = 0		; 嬻拞慜曽僕儍儞僾懍搙

[Movement]
airjump.num = 0       ; 嬻拞僕儍儞僾夞悢
airjump.height = 35  ; 嬻拞僕儍儞僾嵟掅崅搙
yaccel = .58	        ; 僉儍儔廳椡壛懍搙
stand.friction = .85  ; 杸嶤學悢乮棫偪忬懺乯
crouch.friction = .82 ; 杸嶤學悢乮偟傖偑傒忬懺乯

[Quotes]
victory1 = "Power is like this!"
;===============================================================================
; Definition of the Basic Action
;===============================================================================

;-------------------------------------------------------------------------------
; 僟僢僔儏
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.fwd.x)*.7

[State 191, Spray Anim P1]
type = Explod
trigger1 = time >= 0 && timemod = 10,0
trigger1 = StageVar(info.author) = "water"
ID = 20
anim = F21
postype = p1
pos = -10,0
ownpal = 1
ontop = 1
bindtime = 1
removetime = -2

[State 100,1]
type = PlaySnd
trigger1 = Time=3
value = F100,0+(StageVar(info.author) = "water")
loop = 1
channel = 2

[State 100,5]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100,4]
type = ChangeState
trigger1 = Command != "holdfwd" && Time >= 10
value = 101
ctrl = 1

;------------------------ 掆巭
[Statedef 101]
type = S
movetype = I
physics = S
anim = 101
velset = 0, 0

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------
[Statedef 105]
type = S
movetype = I
physics = S
anim = 105
ctrl = 0
velset = 0, 0

[State 191, Spray Anim P1]
type = Explod
trigger1 = AnimElem = 3
trigger1 = StageVar(info.author) = "water"
anim = F21
postype = p1
pos = 0,0
ownpal = 1
ontop = 1
bindtime = 1
removetime = -2

[State 100, 3]
type = PlaySnd
trigger1 = StageVar(info.author) = "water"
trigger1 = AnimElem = 3
value = f47,1

[State 100, 3]
type = PlaySnd
trigger1 = AnimElem = 3
value = F105, 0

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElem = 3
statetype = A
physics = N

[State 105, 1]
type = VelSet
trigger1 = AnimElem = 3
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 1]
type = VelAdd
trigger1 = AnimElem = 3,>= 0
x = .35
y = .53

[State 105,End]
type = ChangeState
trigger1 = AnimElem = 3, > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 106

;------------------------ 掆巭
[Statedef 106]
type = S
movetype = I
physics = S
anim = 106
velset = 0, 0

[State 106, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 191,]
type = PlaySnd
trigger1 = Time = 0
value = f47,0+(StageVar(info.author) = "water")

[State 106, 3];小灰尘
type = GameMakeAnim
triggerall = StageVar(info.author) != "water"
trigger1 = Time = 2
value = 125
pos = -5,-2
under = 0
spacing = 1

[State 0];小水花
type = GameMakeAnim
triggerall = StageVar(info.author) = "water"
trigger1 = Time = 1
value = 21
pos = 0, 0
under = 0

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------
; 僟僂儞夞旔
[Statedef 5201]
type = S
movetype = I
physics = N
anim = 5200
velset = -7, 0
ctrl = 0

[State 5201,PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5201,VelMul]
type = VelMul
trigger1 = 1
x = .87

[State 5201,VelMul]
type = VelSet
trigger1 = AnimElem = 6
x = 0

[State 5201,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 5201,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HIT_LIEDEAD
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = PrevStateNo != 5950
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
triggerall = PrevStateNo != 5950
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, 4] ;Match over anim
type = ChangeAnim
persistent = 0
triggerall = PrevStateNo != 5950
trigger1 = MatchOver = 1
trigger1 = Anim != 5960
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
triggerall = PrevStateNo != 5950
trigger1 = Time = 0
trigger1 = Anim != 5960
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value = 5110

[State 5150, 5]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = PrevStateNo = 5950
value = 5950
elem = 4

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = Vel x < .05
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------
[Statedef 5950]
type = S
movetype = H
physics = S
ctrl = 0
velset = 0, 0

[State 5201,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 154, 1]
type = ChangeAnim
trigger1 = HitOver!
value = ifelse(PrevStateNo = 152,151,150)

[State 151, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 151, 2]
type = VelSet
trigger1 = Time = GetHitVar(slidetime)
trigger2 = HitOver
x = 0

[State 154, 1]
type = ChangeAnim
trigger1 = HitOver && anim != 5950
value = 5950

[State -3,PlaySnd]
type = PlaySnd
trigger1 = anim = 5950
trigger1 = AnimElem = 1,=0
value = 5950, 0

[State 105,End]
type = ChangeState
trigger1 = anim = 5950 && AnimElem = 4
value = 5150
ctrl = 0
