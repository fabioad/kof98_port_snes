trigger1 = Time = 0
var(33) = 0

[State 10000, 1]
type = VarSet
triggerall = Time < 16 && !var(33)
trigger1 = (Target,Command = "holdfwd" || Target,Command = "holdback") && (Target,Command = "x" || Target,Command = "y" || Target,Command = "z")
var(33) = 1

[State 810,TargetBind]
type = ChangeState
trigger1 = Time < 16 && Time > 8 && var(33)
value = 950

[State 860,Width]
type = Width
trigger1 = AnimElem = 1 && FrontEdgeDist < 72
edge = 72,0

[State 860,Width]
type = Width
trigger1 = AnimElem = 3 && FrontEdgeDist < 84
edge = 84,0

[State 860,Width]
type = Width
trigger1 = AnimElem = 6 && FrontEdgeDist < 100
edge = 100,0

[State 860,Width]
type = Width
trigger1 = AnimElem = 22 && FrontEdgeDist < 128
edge = 128,0

[State -3,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3,=-1 || AnimElem = 22,=-1
value = 0, 7
channel = 0

[State -3,PlaySnd]
