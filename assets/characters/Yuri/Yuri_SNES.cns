;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = A
physics = N
anim = 40
ctrl = 0
velset = 0,0
sprpriority = 0

[state -2]
type = nothitby
trigger1 = 1
value = ,AT

[state -2]
type = AfterImage
trigger1 = time = 0
time = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 40, 1]
type = varset
trigger1 = Time = 0
var(27) = 0
[State 40, 1]
type = varset
trigger1 = AnimTime = 0
trigger1 = command != "holdup"
var(27) = 1

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = (command = "holdfwd") - (command = "holdback")

[State 40, vel x]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*ifelse(var(1)>0,1.75,1.0)

[State 40, vel y]
type = VelSet
trigger1 = AnimTime = 0
y = const(velocity.jump.y)*ifelse(var(27)=0,1.0,0.75)

[State 5100, 8]
type = posfreeze
trigger1 = 1

[State -3, Landing Sound]
type = PlaySnd
trigger1 = animtime = 0
value = 6, 1+ifelse(var(1)>0,ifelse(vel X=0,0,1),0)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50-ifelse(var(1)>0,ifelse(vel X=0,0,1),0)
ctrl = 1

