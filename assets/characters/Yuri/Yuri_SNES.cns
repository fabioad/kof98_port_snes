; HITA_UP (initial going up)
[Statedef 5030]
type    = A
movetype= H
physics = N
ctrl = 0

[State 5035, 1]
type = ChangeAnim
trigger1 = anim != [5051,5052]
trigger1 = time = 0
value = 5035

[State 5035, 1]
type = ChangeAnim
trigger1 = 1
trigger1 = Anim = 5090
value = 5090

[State 5030, 1]
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 2]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 5030, 3]
