[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = anim != 5090
value = sysvar(2)

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0
value = sysvar(2)

[State 5080, 4]
