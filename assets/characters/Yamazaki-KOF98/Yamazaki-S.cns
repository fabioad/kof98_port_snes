;---------------------------------------------------------------------------
; ここからは必殺技のステート
;---------------------------------------------------------------------------
; A蛇使い

[Statedef 1000]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = floor(4*fvar(8))
velset   = 0,0
anim     = 1000 + ((var(10) = 1) * 5)
ctrl     = 0
sprpriority = 2
facep2 = 1

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 2
value = s10,20
channel = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 124
value = s10,21
channel = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 244
value = s10,22
channel = 0

[State 1000, ステート変更]
type = ChangeState
triggerall = AnimElemTime(2) >= 0
trigger1 = var(59) != 1
trigger1 = command = "b" || command = "holdb"
trigger2 = var(59) = 1
trigger2 = enemynear(var(58)),statetype != A || p2bodydist x < 0+floor(6*(enemynear(var(58)),vel x))
value = 1030

[State 1000, ステート変更]
type = ChangeState
triggerall = AnimElemTime(2) >= 0
trigger1 = var(59) != 1
trigger1 = command != "holdx"
trigger2 = var(59) = 1
trigger2 = enemynear(var(58)),statetype = A
trigger2 = p2bodydist x = [0+floor(6*(enemynear(var(58)),vel x)),56+floor(6*(enemynear(var(58)),vel x))]
trigger2 = p2bodydist y = [-112-floor(6*(enemynear(var(58)),vel y)+(6*(6+1)/2)*fvar(29)),0-floor(6*(enemynear(var(58)),vel y)+(6*(6+1)/2)*fvar(29))]
value = 1001

[State 1000, ステート変更]
type = ChangeState
trigger1 = Time = 480
value = 1030

