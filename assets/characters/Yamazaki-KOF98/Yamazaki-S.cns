sprpriority = 5
ownpal = 1

[State 1001, MoveHitReset]
type = MoveHitReset
trigger1 = Anim = 1001
trigger1 = AnimElem = 5

[State 1001, ヒット定義]
type = HitDef
triggerall = var(12) = 0
triggerall =!movecontact && !movereversed
trigger1 = Anim = 1001 && AnimElemTime(3) >= 0 && AnimElemTime(4) < 0
trigger1 = var(28) := 1
attr = S, SA
damage    = floor(((12-var(21))/var(23))*fvar(7)),floor(1*fvar(7))
getpower  = floor(4*fvar(8)),floor(4*fvar(8))
givepower = floor(1*fvar(8)),floor(1*fvar(8))
