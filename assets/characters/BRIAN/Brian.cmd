[State -1, Close Stand Light Punch]
type = ChangeState
value = 205
triggerall = Abs(P2bodydist x) <= 24
triggerall = command = "x"
triggerall = command != "holddown"
triggerall = statetype = S
trigger1 = ctrl || Stateno = 100
trigger2 = Var(0) = 2
