; Merged/sanitized CNS for the SNES port (generated)
; Sources (precedence order): Brian-B.cns, Brian-N.cns, Brian-S.cns, Brian-H.cns, Brian-2.cns, Brian.cns, common1.cns

; ===== from Brian-B.cns =====

;-------------------------------------------------------------------------------
; Override common states (use same number to override) :
;-------------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, SprPriority]
type = SprPriority
trigger1 = Roundstate = [0,1]
trigger2 = Roundstate = 2 && !Ctrl
value = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && !AnimTime ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = !Time
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;-------------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
velset = 0,0
ctrl = 0

[State 0, ChangeState]
type = ChangeState
triggerall = Var(59)
trigger1 = P2bodydist X >=170
trigger2 = P2bodydist X = [-30,20]
value = 0
ctrl = 1

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA,NT
time = 1

[State 40, 5]
type = AfterImage
trigger1 = time = 0
time = 1
length = 1

[State 40, 0]
type = turn
triggerall = time = 0
trigger1 = P2dist X < 0

[State 40, 0]
type = VarSet
trigger1 = Time = 0
var(3) = 0

[State 40, 0]
type = VarSet
triggerall = Var(59)>0
trigger1 = Time = 0
var(3) = IfElse(P2BodyDist x >55,2,1)

[State 40, 5]
type = Afterimage
triggerall = Time = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
time = 15
length = 6
PalBright = 0, 0, 0
PalContrast = 128,128,128
PalAdd = 0, 0, 0
PalMul = 1,1,1
FrameGap = 4
Trans = Add1

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(var(3)=0, const(velocity.jump.neu.x), ifelse(var(3)>0, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 1]
type = VarSet
triggerall = !var(59)
trigger1 = command = "holdfwd"
trigger1 = var(3) != 2
var(3) = 1

[State 40, 2]
type = VarSet
triggerall = !var(59)
trigger1 = command = "holdback"
trigger1 = var(3) != -2
var(3) = -1

[State 40, 3]
type = VarSet
triggerall = !var(59)
triggerall = Time = 0
triggerall = command = "holdfwd"
trigger1 = command = "Long Jump";"longjump"
trigger2 = prevstateno = 100 ;RUN_FWD
var(3) = 2

[State 40, 4]
type = VarSet
triggerall = !var(59)
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger1 = command = "Long Jump";"longjump"
var(3) = -2

[State 40, 6]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = var(3) != 0
trigger1 = var(3) != 1
trigger1 = var(3) != -1
trigger1 = command = "holdup"
trigger2 = command != "holdup"
value = 41

[State 40, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;-------------------------------------------------------------------------------
; JUMP_UP (short)
[statedef 41]
type    = a
physics = A
velset = 0, -9
ctrl = 1

[state 41, 2] ; play sound when jumping (long)
type = playsnd
triggerall = time = 0
trigger1 = var(3) = -2
trigger2 = var(3) = 2
value = s40,2

[State 40, 6] ; Play sound when jumping (normal)
type = PlaySnd
trigger1 = Time = 0
trigger1 = var(3) != -2 && var(3) != 2
value = s40,0
channel = 2

[state 41, 3] ; shadows
type = AfterImage
triggerall = time = 0
trigger1 = var(3) = -2
trigger2 = var(3) = 2
time = 17
length = 9
palbright   =   0,  0,  0
palcontrast = 128,128,128
paladd      =   0,  0,  0
palmul      =  1,1,1
framegap = 3
trans = add1

[state 41, 4] ; shadows off
type = AfterImageTime
trigger1 = time = 14
time = 0

[state 41, 5] ;holding up
type = velset
trigger1 = Time =0
y = const(velocity.airjump.y)

[state 41, 5] ;holding up
type = velset
triggerall = time = 0
trigger1 = command = "holdup"
y = const(velocity.jump.y)

[state 41, 6]
type = velset
trigger1 = time = 0
trigger1 = var(3) = 1
x = const(velocity.walk.fwd.x)

[state 41, 7]
type = velset
trigger1 = time = 0
trigger1 = var(3) = 2
x = const(velocity.walk.fwd.x)*1.5

[state 41, 7]
type = velset
triggerall = time = 0
triggerall = var(3) = 2
trigger1 = command = "holdup"
x = const(velocity.walk.fwd.x)*1.5+0.000001

[state 41, 8]
type = velset
trigger1 = time = 0
trigger1 = var(3) = -1
x = const(velocity.walk.back.x)

[state 41, 9]
type = velset
trigger1 = time = 0
trigger1 = var(3) = -2
x = -const(velocity.walk.fwd.x)*1.5

[state 41, 7]
type = velset
triggerall = time = 0
triggerall = var(3) = -2
trigger1 = command = "holdup"
x = -const(velocity.walk.fwd.x)*1.5-0.000001

[state 41, 10]
type = changeanim
triggerall = time = 0
triggerall = vel x = 0
trigger1 = command = "holdup"
value = 41

[state 41, 11] ;short
type = changeanim
triggerall = time = 0
triggerall = vel x = 0
trigger1 = command != "holdup"
value = 41

[state 41, 12]
type = changeanim
triggerall = time = 0
triggerall = vel x > 0
trigger1 = command = "holdup"
value = 42

[state 41, 13] ;short
type = changeanim
triggerall = time = 0
triggerall = vel x >= 0
trigger1 = command != "holdup"
value = 51

[state 41, 13] ;short
type = changeanim
triggerall = time = 0
triggerall = AnimExist(52)
triggerall = vel x > 0
trigger1 = command != "holdup"
value = 52

[State 243, AI BackJump]
type = VelSet
triggerall = var(59) && statetype !=A
trigger1 = p2bodydist x <= 80 && p2statetype != A && backedgebodydist <= 70 && random <= 100 ; For -> Short Jump Backward
y = -7
x = const(velocity.walk.back.x)

[State 243, AI FwdJmp]
type = VelSet
triggerall = var(59) && statetype !=A
trigger1 = p2bodydist x <= 90 && p2statetype !=A && random <= 350 ; For -> Short Jump Forward
y = -7
x = const(velocity.walk.fwd.x)

[State 243, AI FwdJmp2]
type = VelSet
triggerall = var(59) && statetype !=A
trigger1 = (p2bodydist x = [90,180]) && p2movetype !=H && random <= 200 ; For -> Long Jump Forward
y = const(velocity.jump.y)
x = const(velocity.walk.back.x)

[State 243, AI UpJmp]
type = VelSet
triggerall = var(59) && random <= 200 && statetype !=A
trigger1 = Time = 0 && (p2bodydist x <= 50) && p2statetype != L && p2stateno = 5120
y = -7
x = 0

[state 2041, 3.1]
type = changeanim
triggerall = time = 0
triggerall = vel x < 0
trigger1 = command = "holdup"
value = 43

[state 2041, 13] ;short
type = changeanim
triggerall = time = 0
triggerall = vel x < 0
trigger1 = command != "holdup"
value = 51

[state 2041, 13] ;short
type = changeanim
triggerall = time = 0
triggerall = vel x < 0
triggerall = AnimExist(53)
trigger1 = command != "holdup"
value = 53

[State 6100, 2]
type = Null;ChangeState
trigger1 = pos y >= 0 && Vel Y>0
value = 52
;-------------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0,41,ifelse((vel x)>0,42,43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;-------------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
;sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = Time > 3
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 3]
type = ChangeState
trigger1 = (command = "holdup") && (time > 3)
value = 40
ctrl = 0

[State 100, 4]
type = ChangeState
triggerall = !Var(59)
trigger1 = (command != "holdfwd" ||command = "holdback") && (time >= 12)
value = 101

;IA
;Jump
[State 100, 3]
type = ChangeState
triggerall = Var(59)
trigger1 = P2BodyDist x>150 && (time > 5)  &&Random %30=0
trigger2 = P2BodyDist x<60 && (time > 3)  &&Random %5<2
value = 40
ctrl = 0

;Roll FWD
[State 100, 3]
type = ChangeState
triggerall = Var(59)
trigger1 = P2BodyDist x<60 && (time > 3)  &&Random %5>2
value = 900

;Run Back
[State 100, 3]
type = ChangeState
triggerall = Var(59)
trigger1 = P2BodyDist x>150 && (time > 5) &&Random %30=3
value = 105

;Stop Run
[State 100, 5]
type = ChangeState
triggerall = var(59)
triggerall = time >=12
triggerall = p2movetype != H
trigger1 = P2BodyDist x <= 10
trigger2 = P2MoveType = A
value = 101

