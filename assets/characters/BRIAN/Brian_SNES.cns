triggerall = Roundstate = 3
helpertype = normal
name = "Sound K.O"
ID = 56500
stateno = 56500
pos = -10000,-10000
postype = back
keyctrl = 0
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
